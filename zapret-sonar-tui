#!/usr/bin/env bash
# ============================================================================
# zapret-sonar-tui — интерактивная оболочка над CLI zapret-sonar
#
# Тонкая обёртка: вся логика живёт в zapret-sonar, здесь только выбор и
# отображение. Любое действие TUI выражается одной командой CLI, поэтому
# расхождение поведения между интерфейсами невозможно.
#
# Зависимость: fzf (единственная). yad и прочие GUI-тулкиты не нужны.
# ============================================================================

set -uo pipefail

TUI_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
if [[ "${1:-}" == --install-root ]]; then
    [[ $# -ge 2 && -d "$2" && ! -L "$2" ]] || { printf 'некорректный install root\n' >&2; exit 1; }
    TUI_INSTALL_ROOT="$(readlink -f "$2")"
    [[ "$(stat -c %u "$TUI_INSTALL_ROOT" 2>/dev/null)" == 0 \
        && "$(stat -c %u "$TUI_SELF" 2>/dev/null)" == 0 \
        && "$TUI_SELF" == "$TUI_INSTALL_ROOT"/releases/*/zapret-sonar-tui ]] \
        || { printf 'недоверенный install root\n' >&2; exit 1; }
    shift 2
fi

TUI_DIR="$(cd "$(dirname "$TUI_SELF")" && pwd)"
CLI="${TUI_INSTALL_ROOT:-$TUI_DIR}/zapret-sonar"
[[ -x "$CLI" ]] || { printf 'не найден zapret-sonar рядом с TUI: %s\n' "$CLI" >&2; exit 1; }
command -v fzf >/dev/null 2>&1 || { printf 'нужен fzf: pacman -S fzf\n' >&2; exit 1; }

# fzf без --color использует цвета терминала. Это намеренно: Tokyo Night
# или любая другая тема терминала применяется автоматически, а хардкод
# RGB-значений ломался бы на светлых темах.

C_DIM=$'\033[2m'; C_OK=$'\033[32m'; C_BAD=$'\033[31m'
C_ACC=$'\033[34m'; C_WARN=$'\033[33m'; C_OFF=$'\033[0m'

# Разделители между группами пунктов. Префикс не даст fzf найти их поиском,
# а «──» вместо «───» делает их короче выбираемых строк — визуально группируют.
SEP_CHECK="${C_DIM}── Проверка${C_OFF}"
SEP_CONF="${C_DIM}── Настройки${C_OFF}"
SEP_SVC="${C_DIM}── Сервис${C_OFF}"
MENU_CHECK='Проверить HTTP/CDN и QUIC'

pause() { printf '\n%sEnter — назад%s' "$C_DIM" "$C_OFF"; read -r -s -n1 _ 2>/dev/null || true; printf '\n'; }

# --- Шапка -------------------------------------------------------------------
