#!/usr/bin/env bash
# ============================================================================
# zapret-sonar — обёртка над zapret v1 (bol-van) со стратегиями Flowseal
#
# Задача: дать быстрое переключение проверенных стратегий Flowseal на Linux.
# Firewall, systemd и демонизацию делает сам zapret — здесь только
# трансляция стратегий, состояние и проверки.
#
# Привилегии: команды, меняющие конфиг или сервис, требуют root и вызывают
# sudo явно. Беспарольного доступа (NOPASSWD) намеренно нет — это источник
# эскалации привилегий, а ввод пароля ничего не стоит.
# ============================================================================

set -uo pipefail

ZF_VERSION="1.4.0"
ZF_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
if [[ "${1:-}" == --install-root ]]; then
    [[ $# -ge 2 && -d "$2" && ! -L "$2" ]] || { printf 'ошибка: некорректный install root\n' >&2; exit 1; }
    ZF_INSTALL_ROOT="$(readlink -f "$2")"
    [[ "$(stat -c %u "$ZF_INSTALL_ROOT" 2>/dev/null)" == 0 \
        && "$(( 8#$(stat -c %a "$ZF_INSTALL_ROOT" 2>/dev/null) & 8#022 ))" == 0 \
        && "$(stat -c %u "$ZF_INSTALL_ROOT/releases" 2>/dev/null)" == 0 \
        && "$(( 8#$(stat -c %a "$ZF_INSTALL_ROOT/releases" 2>/dev/null) & 8#022 ))" == 0 \
        && -L "$ZF_INSTALL_ROOT/current" \
        && "$(stat -c %u "$ZF_SELF" 2>/dev/null)" == 0 \
        && "$(( 8#$(stat -c %a "$ZF_SELF" 2>/dev/null) & 8#022 ))" == 0 \
        && "$ZF_SELF" == "$ZF_INSTALL_ROOT"/releases/*/zapret-sonar ]] \
        || { printf 'ошибка: недоверенный install root\n' >&2; exit 1; }
    shift 2
fi
ZF_DIR="$(cd "$(dirname "$ZF_SELF")" && pwd)"
ZF_INSTALL_ROOT="${ZF_INSTALL_ROOT:-$ZF_DIR}"

# Пути и имя сервиса, зафиксированные установщиком. Нужны, когда ставили не в
# /opt/zapret (например, рядом с уже занятым каталогом): без этого CLI искал бы
# стратегии и сервис не там, где они на самом деле.
# shellcheck source=/dev/null
[[ -f "$ZF_INSTALL_ROOT/lib/paths.sh" ]] && source "$ZF_INSTALL_ROOT/lib/paths.sh"

source "$ZF_DIR/lib/translate.sh"
source "$ZF_DIR/lib/zconfig.sh"
source "$ZF_DIR/lib/health.sh"
source "$ZF_DIR/lib/flowseal.sh"
source "$ZF_DIR/lib/self-update.sh"

ZF_FLOWSEAL_CURRENT="${ZF_FLOWSEAL_CURRENT:-$ZF_ZAPRET_BASE/flowseal-current}"
if [[ -d "$ZF_FLOWSEAL_CURRENT" ]]; then
    ZF_STRATEGIES_DIR="${ZF_STRATEGIES_DIR:-$ZF_FLOWSEAL_CURRENT/strategies}"
    ZF_BIN_DIR="${ZF_BIN_DIR:-$ZF_FLOWSEAL_CURRENT/bin}"
    ZF_LISTS_DIR="${ZF_LISTS_DIR:-$ZF_FLOWSEAL_CURRENT/lists}"
else
    ZF_STRATEGIES_DIR="${ZF_STRATEGIES_DIR:-$ZF_ZAPRET_BASE/flowseal-strategies}"
    ZF_BIN_DIR="${ZF_BIN_DIR:-$ZF_ZAPRET_BASE/flowseal-bin}"
    ZF_LISTS_DIR="${ZF_LISTS_DIR:-$ZF_ZAPRET_BASE/flowseal-lists}"
fi
ZF_NFQWS="${ZF_NFQWS:-$ZF_ZAPRET_BASE/nfq/nfqws}"
ZF_SERVICE="${ZF_SERVICE:-zapret}"
ZF_BIN_DEST="${ZF_BIN_DEST:-/usr/local/bin}"

die() { printf 'ошибка: %s\n' "$*" >&2; exit 1; }

# Список стратегий в порядке Flowseal: числа сравниваются как числа,
# чтобы ALT2 шёл перед ALT10, а не после (service.bat делает так же).
zf_list_strategies() {
    [[ -d "$ZF_STRATEGIES_DIR" ]] || return 1
    find "$ZF_STRATEGIES_DIR" -maxdepth 1 -name '*.bat' -not -name 'service*' -printf '%f\n' 2>/dev/null \
        | sort -V
}

# Разрешение имени: точное, затем подстрока без учёта регистра.
# Позволяет писать `use alt12` вместо `use "general (ALT12).bat"`.
zf_resolve_strategy() {
    local q="$1" all match n
    all=$(zf_list_strategies) || return 1
    if printf '%s\n' "$all" | grep -qxF "$q"; then printf '%s\n' "$q"; return 0; fi
    match=$(printf '%s\n' "$all" | grep -iF "$q")
    n=$(printf '%s\n' "$match" | grep -c .)
    if (( n == 1 )); then printf '%s\n' "$match"; return 0; fi
    if (( n == 0 )); then printf 'стратегия не найдена: %s\n' "$q" >&2; return 1; fi
    printf 'неоднозначно (%s совпадений):\n%s\n' "$n" "$match" >&2
    return 1
}

zf_validate_flowseal_tree() {
    local tree="$1" strategy file missing
    local strategies="$tree/strategies" bin="$tree/bin" lists="$tree/lists"
    [[ -d "$strategies" && -d "$bin" && -d "$lists" ]] || return 1
    while IFS= read -r strategy; do
        [[ -n "$strategy" ]] || continue
        zf_translate "$strategies/$strategy" "$bin" "$lists" off >/dev/null 2>&1 || return 1
        missing=0
        while IFS= read -r file; do
            [[ -z "$file" || -e "$file" ]] || missing=1
        done < <(zf_referenced_files)
        (( missing == 0 )) || return 1
        zf_verify "$ZF_NFQWS" >/dev/null 2>&1 || return 1
    done < <(find "$strategies" -maxdepth 1 -name '*.bat' -not -name 'service*' -printf '%f\n' 2>/dev/null | sort -V)
}

_zf_validate_strategy() {
    local strategy="$1" strategies="$2" bin="$3" lists="$4" file
    ZF_VALIDATE_STAGE=""; ZF_VALIDATE_REASON=""; ZF_VALIDATE_REFERENCE=""
    if ! zf_translate "$strategies/$strategy" "$bin" "$lists" off >/dev/null 2>&1; then
        ZF_VALIDATE_STAGE=translate; ZF_VALIDATE_REASON=translate_failed; return 1
    fi
    while IFS= read -r file; do
        [[ -z "$file" || -e "$file" ]] && continue
        ZF_VALIDATE_STAGE=references; ZF_VALIDATE_REASON=missing_reference
        ZF_VALIDATE_REFERENCE="${file#"$ZF_FLOWSEAL_CURRENT/"}"
        return 1
    done < <(zf_referenced_files)
    if ! zf_verify "$ZF_NFQWS" >/dev/null 2>&1; then
        ZF_VALIDATE_STAGE=nfqws; ZF_VALIDATE_REASON=nfqws_rejected; return 1
    fi
}

_zf_collect_validation() {
    local strategy record
    ZF_VALIDATE_TOTAL=0; ZF_VALIDATE_PASSED=0; ZF_VALIDATE_FAILED=0
    ZF_VALIDATE_RECORDS=()
    while IFS= read -r strategy; do
        [[ -n "$strategy" ]] || continue
        ZF_VALIDATE_TOTAL=$((ZF_VALIDATE_TOTAL + 1))
        if _zf_validate_strategy "$strategy" "$ZF_STRATEGIES_DIR" "$ZF_BIN_DIR" "$ZF_LISTS_DIR"; then
            ZF_VALIDATE_PASSED=$((ZF_VALIDATE_PASSED + 1))
            record="$strategy"$'\tpass\t\t\t'
        else
            ZF_VALIDATE_FAILED=$((ZF_VALIDATE_FAILED + 1))
            record="$strategy"$'\tfail\t'"$ZF_VALIDATE_STAGE"$'\t'"$ZF_VALIDATE_REASON"$'\t'"$ZF_VALIDATE_REFERENCE"
        fi
        ZF_VALIDATE_RECORDS+=("$record")
    done < <(zf_list_strategies)
    (( ZF_VALIDATE_TOTAL > 0 && ZF_VALIDATE_FAILED == 0 ))
}

cmd_validate() {
    local json=0 arg
    for arg in "$@"; do case "$arg" in --json) json=1 ;; *) die "validate: неизвестный ключ $arg" ;; esac; done
    local rc=0 record strategy status stage reason reference first=1
    _zf_collect_validation || rc=1
    if (( json )); then
        ZF_MACHINE_OUTPUT=1
        printf '{"schema_version":1,"command":"validate","ok":%s,"summary":{"total":%d,"passed":%d,"failed":%d},"results":[' \
            "$([[ $rc -eq 0 ]] && printf true || printf false)" "$ZF_VALIDATE_TOTAL" "$ZF_VALIDATE_PASSED" "$ZF_VALIDATE_FAILED"
        for record in "${ZF_VALIDATE_RECORDS[@]}"; do
            IFS=$'\t' read -r strategy status stage reason reference <<< "$record"
            (( first )) || printf ','; first=0
            printf '{"strategy":"%s","status":"%s","stage":%s,"reason":%s,"reference":%s}' \
                "$(_zf_json_escape "$strategy")" "$status" \
                "$([[ -n "$stage" ]] && printf '"%s"' "$stage" || printf null)" \
                "$([[ -n "$reason" ]] && printf '"%s"' "$reason" || printf null)" \
                "$([[ -n "$reference" ]] && printf '"%s"' "$(_zf_json_escape "$reference")" || printf null)"
        done
        printf ']}\n'
    else
        for record in "${ZF_VALIDATE_RECORDS[@]}"; do
            IFS=$'\t' read -r strategy status stage reason reference <<< "$record"
            if [[ "$status" == pass ]]; then printf 'PASS  %s\n' "$strategy"
            else printf 'FAIL  %s  %s%s\n' "$strategy" "$reason" "${reference:+: $reference}"; fi
        done
        printf '\nИтог: %d пройдено, %d ошибок, всего %d\n' "$ZF_VALIDATE_PASSED" "$ZF_VALIDATE_FAILED" "$ZF_VALIDATE_TOTAL"
    fi
    return "$rc"
}

cmd_export_diagnostic() {
    local output="" arg tmp="" rc=0
    while (( $# )); do
        arg="$1"; shift
        case "$arg" in
            --output) [[ $# -gt 0 ]] || die "export-diagnostic: после --output нужен файл"; output="$1"; shift ;;
            *) die "export-diagnostic: неизвестный ключ $arg" ;;
        esac
    done
    ZF_MACHINE_OUTPUT=1
    local os_id="" os_version="" arch kernel st strategy gf ipset fs_ver zap_ver
    if [[ -r /etc/os-release ]]; then
        os_id=$(sed -n 's/^ID=//p' /etc/os-release | head -1 | tr -d '"')
        os_version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | head -1 | tr -d '"')
    fi
    arch=$(uname -m 2>/dev/null || true); kernel=$(uname -r 2>/dev/null || true)
    st=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)
    strategy=$(zf_state strategy || true); gf=$(zf_state gamefilter || true); ipset=$(zf_ipset_mode "$ZF_LISTS_DIR")
    fs_ver=""; [[ -f "$(_zf_flowseal_ver_file)" ]] && fs_ver=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)" 2>/dev/null)
    zap_ver=$(_zf_nfqws_version 2>/dev/null || true)
    local config_present=false config_ok=false nfqws_ok=false
    [[ -f "$ZF_ZAPRET_CONFIG" ]] && config_present=true
    [[ -r "$ZF_ZAPRET_CONFIG" ]] && bash -n "$ZF_ZAPRET_CONFIG" 2>/dev/null && config_ok=true
    [[ -x "$ZF_NFQWS" ]] && nfqws_ok=true
    _zf_collect_validation >/dev/null 2>&1 || true
    local document
    document=$(printf '{"schema_version":1,"kind":"zapret-sonar-diagnostic","sonar_version":"%s","platform":{"os_id":"%s","os_version_id":"%s","architecture":"%s","kernel_release":"%s"},"status":{"service_state":"%s","strategy":"%s","gamefilter":"%s","ipset":"%s","zapret":"%s","flowseal":"%s"},"installation":{"strategy_count":%d,"config_present":%s,"config_syntax_ok":%s,"nfqws_executable":%s},"validation":{"ok":%s,"total":%d,"passed":%d,"failed":%d},"privacy":{"raw_config_included":false,"logs_included":false,"domain_lists_included":false,"network_addresses_included":false}}\n' \
        "$ZF_VERSION" "$(_zf_json_escape "$os_id")" "$(_zf_json_escape "$os_version")" "$(_zf_json_escape "$arch")" "$(_zf_json_escape "$kernel")" \
        "$(_zf_json_escape "$st")" "$(_zf_json_escape "$strategy")" "$(_zf_json_escape "$gf")" "$(_zf_json_escape "$ipset")" "$(_zf_json_escape "$zap_ver")" "$(_zf_json_escape "$fs_ver")" \
        "$ZF_VALIDATE_TOTAL" "$config_present" "$config_ok" "$nfqws_ok" \
        "$([[ $ZF_VALIDATE_FAILED -eq 0 && $ZF_VALIDATE_TOTAL -gt 0 ]] && printf true || printf false)" \
        "$ZF_VALIDATE_TOTAL" "$ZF_VALIDATE_PASSED" "$ZF_VALIDATE_FAILED") || rc=1
    (( rc == 0 )) || return 1
    if [[ -z "$output" ]]; then printf '%s' "$document"; return 0; fi
    tmp=$(mktemp "${output}.XXXXXX") || die "не удалось создать временный файл рядом с $output"
    chmod 600 "$tmp" && printf '%s' "$document" > "$tmp" && mv -f "$tmp" "$output" \
        || { rm -f "$tmp"; die "не удалось записать $output"; }
    printf 'диагностика сохранена: %s\n' "$output" >&2
}

need_root() {
    [[ $EUID -eq 0 ]] && return 0
    command -v sudo >/dev/null 2>&1 || die "нужны права root, sudo не найден"
    return 1
}

_zf_sudo_self() {
    local executable="$ZF_SELF"
    [[ -L "$ZF_INSTALL_ROOT/current" && -x "$ZF_INSTALL_ROOT/zapret-sonar" ]] && executable="$ZF_INSTALL_ROOT/zapret-sonar"
    sudo -- "$executable" "$@"
}

_zf_require_root() {
    [[ $EUID -eq 0 ]] || die "$1 требует root"
}

# Общий lock для всех операций, меняющих конфиг, бинарники, списки или сервис.
# Каталог под /run создаётся root и недоступен для подмены обычным пользователем.
_ZF_RUNTIME_DIR="${ZF_RUNTIME_DIR:-/run/zapret-sonar}"
_ZF_LOCK="$_ZF_RUNTIME_DIR/operations.lock"
_ZF_LOCK_HELD="${ZF_LOCK_HELD:-0}"
_zf_lock() {
    (( _ZF_LOCK_HELD )) && return 0
    [[ ! -L "$_ZF_RUNTIME_DIR" ]] || die "небезопасный runtime-каталог: $_ZF_RUNTIME_DIR"
    install -d -m 0755 "$_ZF_RUNTIME_DIR" || die "не удалось создать $_ZF_RUNTIME_DIR"
    [[ "$(stat -c %u "$_ZF_RUNTIME_DIR" 2>/dev/null)" == "$EUID" ]] \
        || die "неверный владелец runtime-каталога: $_ZF_RUNTIME_DIR"
    [[ ! -L "$_ZF_LOCK" ]] || die "lock-файл не должен быть симлинком: $_ZF_LOCK"
    exec 9>"$_ZF_LOCK"
    if ! flock -n 9; then
        die "операция уже выполняется в другом терминале"
    fi
    _ZF_LOCK_HELD=1
}

# --- Версии ------------------------------------------------------------------
# Flowseal: версия хранится в .flowseal-version (тег релиза с GitHub).
# zapret: версия читается из nfqws --version — файл не нужен.
_zf_flowseal_ver_file() { printf '%s/.flowseal-version\n' "$ZF_ZAPRET_BASE"; }

_zf_nfqws_version() { "$ZF_NFQWS" --version 2>&1 | head -1; }

_zf_config_literal() {
    local key="$1" line value
    line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$ZF_ZAPRET_CONFIG" 2>/dev/null | tail -1)
    [[ -n "$line" ]] || return 2
    [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?${key}=([^#[:space:]]+)([[:space:]]+#.*)?[[:space:]]*$ ]] || return 1
    value="${BASH_REMATCH[2]}"
    case "$value" in
        \"*\") [[ "$value" == *\" && ${#value} -ge 2 ]] || return 1; value="${value:1:${#value}-2}" ;;
        \'*\') [[ "$value" == *\' && ${#value} -ge 2 ]] || return 1; value="${value:1:${#value}-2}" ;;
    esac
    [[ "$value" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    printf '%s\n' "$value"
}

_zf_config_literal_or_default() {
    local key="$1" default="$2" value rc
    set +e
    value=$(_zf_config_literal "$key"); rc=$?
    set -e
    case "$rc" in
        0) printf '%s\n' "$value" ;;
        2) printf '%s\n' "$default" ;;
        *) return 1 ;;
    esac
}

_zf_nfqws_uses_queue() {
    local qnum="$1" expected proc exe args
    expected=$(readlink -f "$ZF_NFQWS" 2>/dev/null) || return 1
    for proc in /proc/[0-9]*; do
        exe=$(readlink -f "$proc/exe" 2>/dev/null) || continue
        [[ "$exe" == "$expected" ]] || continue
        args=$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null) || continue
        [[ " $args " == *" --qnum=$qnum "* ]] && return 0
    done
    return 1
}

_zf_json_escape() {
    local value="$1" out="" char escaped code i
    local LC_ALL=C
    for ((i = 0; i < ${#value}; i++)); do
        char=${value:i:1}
        case "$char" in
            '"') escaped='\"' ;;
            \\) escaped='\\' ;;
            $'\b') escaped='\b' ;;
            $'\f') escaped='\f' ;;
            $'\n') escaped='\n' ;;
            $'\r') escaped='\r' ;;
            $'\t') escaped='\t' ;;
            *)
                printf -v code '%d' "'$char"
                if (( code < 32 )); then
                    printf -v escaped '\\u%04x' "$code"
                else
                    escaped=$char
                fi
                ;;
        esac
        out+=$escaped
    done
    printf '%s' "$out"
}

_zf_github_latest_tag() {
    local repo="$1" tag
    tag=$(curl -s -m 15 "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
        | grep -oP '"tag_name":\s*"\K[^"]+' | head -1)
    [[ -n "$tag" ]] && printf '%s\n' "$tag"
}

_zf_detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64) printf 'linux-x86_64\n' ;;
        i?86)         printf 'linux-x86\n' ;;
        aarch64|arm64) printf 'linux-arm64\n' ;;
        armv7l|armv6l|arm) printf 'linux-arm\n' ;;
        *) die "неизвестная архитектура: $(uname -m)" ;;
    esac
}

# --- Проверка обновлений (фоновая, без systemd) ------------------------------
# При запуске CLI/TUI проверяет наличие новых версий Flowseal и zapret.
# Результат кэшируется на 1 час в приватном пользовательском каталоге.
_ZF_UPDATE_CACHE_DIR="${ZF_UPDATE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zapret-sonar}"
_ZF_UPDATE_CACHE="$_ZF_UPDATE_CACHE_DIR/update-check"
_ZF_UPDATE_LOCK="$_ZF_UPDATE_CACHE_DIR/update-check.lock"

_zf_prepare_update_cache() {
    [[ ! -L "$_ZF_UPDATE_CACHE_DIR" ]] || return 1
    mkdir -p "$_ZF_UPDATE_CACHE_DIR" 2>/dev/null || return 1
    chmod 700 "$_ZF_UPDATE_CACHE_DIR" 2>/dev/null || return 1
    [[ "$(stat -c %u "$_ZF_UPDATE_CACHE_DIR" 2>/dev/null)" == "$EUID" ]]
}

_zf_invalidate_update_cache() {
    _zf_prepare_update_cache || return 0
    rm -f "$_ZF_UPDATE_CACHE"
}

_zf_invalidate_update_caches() {
    _zf_invalidate_update_cache
    if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then
        local user_home user_uid user_cache
        user_home=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)
        user_uid=$(id -u "$SUDO_USER" 2>/dev/null || true)
        user_cache="$user_home/.cache/zapret-sonar"
        if [[ -n "$user_home" && -n "$user_uid" && -d "$user_cache" && ! -L "$user_cache" \
              && "$(stat -c %u "$user_cache" 2>/dev/null)" == "$user_uid" ]]; then
            [[ -L "$user_cache/update-check" ]] || rm -f "$user_cache/update-check"
        fi
    fi
}

_zf_version_is_newer() {
    local remote="${1#v}" local_version="${2#v}"
    [[ -n "$remote" && -n "$local_version" && "$remote" != "$local_version" ]] || return 1
    [[ "$remote" =~ ^[0-9]+([.][0-9]+)*$ ]] || return 1
    [[ "$local_version" =~ ^[0-9]+([.][0-9]+)*$ ]] || return 0
    [[ "$(printf '%s\n%s\n' "$remote" "$local_version" | sort -V | tail -1)" == "$remote" ]]
}

_zf_spawn_update_check() {
    nohup env \
        ZF_LIBRARY_MODE=0 \
        ZF_UPDATE_CACHE_DIR="$_ZF_UPDATE_CACHE_DIR" \
        ZF_ZAPRET_BASE="$ZF_ZAPRET_BASE" \
        ZF_NFQWS="$ZF_NFQWS" \
        "$ZF_SELF" _update_check_worker </dev/null >/dev/null 2>&1 8>&- 9>&- &
}

_zf_do_update_check() {
    _zf_prepare_update_cache || return 1
    [[ ! -L "$_ZF_UPDATE_LOCK" ]] || return 1
    exec 8>"$_ZF_UPDATE_LOCK" || return 1
    flock -n 8 || return 0

    local fs_local="" fs_remote="" zap_local="" zap_remote="" sonar_remote="" state="ok"
    local fs_result zap_result sonar_result fs_pid zap_pid sonar_pid
    fs_result=$(mktemp "$_ZF_UPDATE_CACHE_DIR/flowseal.XXXXXX") || return 1
    zap_result=$(mktemp "$_ZF_UPDATE_CACHE_DIR/zapret.XXXXXX") || { rm -f "$fs_result"; return 1; }
    sonar_result=$(mktemp "$_ZF_UPDATE_CACHE_DIR/sonar.XXXXXX") || { rm -f "$fs_result" "$zap_result"; return 1; }

    [[ -f "$(_zf_flowseal_ver_file)" ]] && fs_local=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)" 2>/dev/null)
    fs_local="${fs_local#v}"
    ( _zf_github_latest_tag "Flowseal/zapret-discord-youtube" > "$fs_result" ) & fs_pid=$!
    ( _zf_github_latest_tag "bol-van/zapret" > "$zap_result" ) & zap_pid=$!
    ( _zf_github_latest_tag "$ZF_SELF_REPO" > "$sonar_result" ) & sonar_pid=$!
    wait "$fs_pid" || state="error"
    wait "$zap_pid" || state="error"
    wait "$sonar_pid" || state="error"
    fs_remote=$(tr -d '[:space:]' < "$fs_result" 2>/dev/null)
    zap_remote=$(tr -d '[:space:]' < "$zap_result" 2>/dev/null)
    sonar_remote=$(tr -d '[:space:]' < "$sonar_result" 2>/dev/null)
    rm -f "$fs_result" "$zap_result" "$sonar_result"
    fs_remote="${fs_remote#v}"
    sonar_remote="${sonar_remote#v}"

    zap_local=$(_zf_nfqws_version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+' | head -1)
    [[ -n "$fs_remote" && -n "$zap_remote" && -n "$sonar_remote" ]] || state="error"

    local now tmp; now=$(date +%s)
    tmp=$(mktemp "$_ZF_UPDATE_CACHE_DIR/update-check.XXXXXX") || return 1
    {
        printf 'check_state=%s\n' "$state"
        printf 'flowseal_local=%s\n' "$fs_local"
        printf 'flowseal_remote=%s\n' "$fs_remote"
        printf 'zapret_local=%s\n' "$zap_local"
        printf 'zapret_remote=%s\n' "$zap_remote"
        printf 'sonar_remote=%s\n' "$sonar_remote"
        printf 'last_check=%s\n' "$now"
    } > "$tmp"
    chmod 600 "$tmp" && mv -f "$tmp" "$_ZF_UPDATE_CACHE" || { rm -f "$tmp"; return 1; }
}

_zf_update_check() {
    _zf_prepare_update_cache || return 1
    local now; now=$(date +%s)
    local cached="" last_check=0 state=""
    [[ -f "$_ZF_UPDATE_CACHE" && ! -L "$_ZF_UPDATE_CACHE" ]] && cached=$(cat "$_ZF_UPDATE_CACHE" 2>/dev/null)
    [[ -n "$cached" ]] && last_check=$(printf '%s' "$cached" | grep '^last_check=' | cut -d= -f2)
    [[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0
    [[ -n "$cached" ]] && state=$(printf '%s' "$cached" | grep '^check_state=' | cut -d= -f2)
    local ttl=3600
    [[ "$state" == "error" ]] && ttl=300

    if (( now - last_check > ttl )); then
        _zf_spawn_update_check
    fi
    printf '%s' "$cached"
}

_zf_update_status() {
    local cached; cached=$(_zf_update_check 2>/dev/null)
    [[ -z "$cached" ]] && { printf 'проверка…'; return 0; }

    local state fs_local fs_remote zap_local zap_remote sonar_remote
    state=$(printf '%s' "$cached" | grep '^check_state=' | cut -d= -f2)
    [[ "$state" == "error" ]] && { printf 'проверка недоступна'; return 0; }
    fs_local=""
    [[ -f "$(_zf_flowseal_ver_file)" ]] && fs_local=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)" 2>/dev/null)
    fs_local="${fs_local#v}"
    fs_remote=$(printf '%s' "$cached" | grep '^flowseal_remote=' | cut -d= -f2)
    zap_local=$(_zf_nfqws_version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+' | head -1)
    zap_remote=$(printf '%s' "$cached" | grep '^zapret_remote=' | cut -d= -f2)
    sonar_remote=$(printf '%s' "$cached" | grep '^sonar_remote=' | cut -d= -f2)

    local out=""
    if _zf_version_is_newer "$fs_remote" "$fs_local"; then
        out="стратегии $fs_remote (у вас $fs_local)"
    fi
    if [[ -n "$zap_remote" && -n "$zap_local" ]]; then
        if [[ "$(printf '%s\n%s\n' "$zap_remote" "$zap_local" | sort -V | tail -1)" != "$zap_local" ]]; then
            [[ -n "$out" ]] && out="$out · "
            out="${out}движок $zap_remote (у вас $zap_local)"
        fi
    fi
    if _zf_version_is_newer "$sonar_remote" "$ZF_VERSION"; then
        [[ -n "$out" ]] && out="$out · "
        out="${out}zapret-sonar $sonar_remote (у вас $ZF_VERSION)"
    fi

    if [[ -z "$out" ]]; then printf 'актуально'
    else printf '%s' "$out"
    fi
}

_zf_update_status_wait() {
    local status i
    for ((i = 0; i < 80; i++)); do
        status=$(_zf_update_status 2>/dev/null)
        [[ "$status" != "проверка…" ]] && { printf '%s' "$status"; return 0; }
        sleep 0.25
    done
    printf 'проверка недоступна'
}

_zf_update_notify() {
    local status; status=$(_zf_update_status 2>/dev/null)
    case "$status" in
        актуально|проверка…|"проверка недоступна") return 0 ;;
        *) printf '\n⚠ Доступно обновление: %s\n  sudo sonar update — стратегии\n  sudo sonar upgrade — движок\n  sonar self-update — zapret-sonar\n' "$status" ;;
    esac
}

cmd_list() {
    local cur; cur=$(zf_state strategy)
    local s
    while IFS= read -r s; do
        [[ -z "$s" ]] && continue
        if [[ "$s" == "$cur" ]]; then printf '* %s\n' "$s"; else printf '  %s\n' "$s"; fi
    done < <(zf_list_strategies)
    [[ -n "$cur" ]] && printf '\n* — применена сейчас\n'
    printf 'У Flowseal нет «правильной» стратегии: перебирайте, пока не найдёте рабочую.\n'
}

cmd_use() {
    local q="${1:-}" gf ipset name
    [[ -n "$q" ]] || die "укажите стратегию (zapret-sonar list — показать все)"
    name=$(zf_resolve_strategy "$q") || exit 1

    # Режимы сохраняются между переключениями: их менять — отдельное действие.
    gf=$(zf_state gamefilter); gf="${gf:-off}"
    ipset=$(zf_ipset_mode "$ZF_LISTS_DIR")

    zf_translate "$ZF_STRATEGIES_DIR/$name" "$ZF_BIN_DIR" "$ZF_LISTS_DIR" "$gf" || exit 1

    # Проверка файлов ДО nfqws --dry-run: nfqws сам открывает hostlist'ы
    # и падает с невнятным «cannot open», наша проверка понятнее.
    local missing=0 f
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -e "$f" ]] || { printf 'нет файла: %s\n' "$f" >&2; missing=1; }
    done < <(zf_referenced_files)
    (( missing == 0 )) || die "стратегия ссылается на отсутствующие файлы"

    # Проверка через сам nfqws: он разбирает аргументы своим парсером,
    # ничего не запуская. Ошибка здесь дешевле, чем рестарт-цикл сервиса.
    zf_verify "$ZF_NFQWS" || die "nfqws отверг аргументы стратегии, конфиг не изменён"

    if need_root; then
        cmd_apply "$name" "$gf" "$ipset" || exit 1
    else
        _zf_sudo_self _apply "$name" "$gf" "$ipset" || exit 1
    fi
    printf 'применена: %s (gamefilter=%s ipset=%s)\n' "$name" "$gf" "$ipset"
}

# Внутренняя команда для переустановки: пересобирает конфиг без изменения
# состояния сервиса. Обычное применение выполняет restart после неё.
cmd_render() {
    local name="$1" gf="$2" ipset="$3"
    _zf_require_root _render
    _zf_lock
    zf_translate "$ZF_STRATEGIES_DIR/$name" "$ZF_BIN_DIR" "$ZF_LISTS_DIR" "$gf" || return 1
    zf_verify "$ZF_NFQWS" || { printf 'ошибка: nfqws отверг аргументы\n' >&2; return 1; }
    zf_write_config "$name" "$gf" "$ipset" || { printf 'ошибка: не удалось записать конфиг\n' >&2; return 1; }
}

# Внутренняя команда: выполняется уже от root после sudo из cmd_use.
cmd_apply() {
    local name="$1" gf="$2" ipset="$3"
    _zf_require_root _apply
    _zf_lock
    local backup="" marker_backup="" had_config=0 had_marker=0 was_active=0 restore_ok=1
    [[ "$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)" == active ]] && was_active=1
    if [[ -f "$ZF_ZAPRET_CONFIG" ]]; then
        backup=$(mktemp "$ZF_ZAPRET_BASE/.config.apply.XXXXXX") || return 1
        cp -a "$ZF_ZAPRET_CONFIG" "$backup" || { rm -f "$backup"; return 1; }
        had_config=1
    fi
    local marker
    marker=$(_zf_firewall_owner_file)
    if [[ -f "$marker" ]]; then
        marker_backup=$(mktemp "$ZF_ZAPRET_BASE/.firewall-owner.apply.XXXXXX") || { rm -f "$backup"; return 1; }
        cp -a "$marker" "$marker_backup" || { rm -f "$backup" "$marker_backup"; return 1; }
        had_marker=1
    fi
    local old_int old_term old_hup
    old_int=$(trap -p INT); old_term=$(trap -p TERM); old_hup=$(trap -p HUP)
    _zf_restore_signal_traps() {
        trap - INT TERM HUP
        [[ -n "$old_int" ]] && eval "$old_int"
        [[ -n "$old_term" ]] && eval "$old_term"
        [[ -n "$old_hup" ]] && eval "$old_hup"
    }
    _zf_apply_interrupted() {
        local signal="$1"
        _zf_restore_signal_traps
        if (( had_config )); then cp -a "$backup" "$ZF_ZAPRET_CONFIG" >/dev/null 2>&1 || true
        else rm -f "$ZF_ZAPRET_CONFIG"; fi
        if (( was_active )); then systemctl restart "$ZF_SERVICE" >/dev/null 2>&1 || true
        else systemctl stop "$ZF_SERVICE" >/dev/null 2>&1 || true; fi
        if (( had_marker )); then cp -a "$marker_backup" "$marker" >/dev/null 2>&1 || true
        else rm -f "$marker"; fi
        rm -f "$backup" "$marker_backup"
        case "$signal" in
            INT)  [[ -n "$old_int" ]] && kill -s INT "$$"; exit 130 ;;
            TERM) [[ -n "$old_term" ]] && kill -s TERM "$$"; exit 143 ;;
            HUP)  [[ -n "$old_hup" ]] && kill -s HUP "$$"; exit 129 ;;
        esac
    }
    trap '_zf_apply_interrupted INT' INT
    trap '_zf_apply_interrupted TERM' TERM
    trap '_zf_apply_interrupted HUP' HUP

    if ! cmd_render "$name" "$gf" "$ipset"; then
        _zf_restore_signal_traps
        rm -f "$backup" "$marker_backup"
        return 1
    fi
    if ! systemctl restart "$ZF_SERVICE"; then
        _zf_restore_signal_traps
        if (( had_config )); then
            cp -a "$backup" "$ZF_ZAPRET_CONFIG" || restore_ok=0
        else
            rm -f "$ZF_ZAPRET_CONFIG" || restore_ok=0
        fi
        if (( was_active )); then
            systemctl restart "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        else
            systemctl stop "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        fi
        rm -f "$backup" "$marker_backup"
        (( restore_ok )) || { printf 'ошибка: применение не удалось, прежнее состояние восстановить не удалось\n' >&2; return 1; }
        printf 'ошибка: применение не удалось, прежнее состояние восстановлено\n' >&2
        return 1
    fi
    _zf_record_firewall_ownership || {
        _zf_restore_signal_traps
        if (( had_config )); then
            cp -a "$backup" "$ZF_ZAPRET_CONFIG" || restore_ok=0
        else
            rm -f "$ZF_ZAPRET_CONFIG" || restore_ok=0
        fi
        if (( had_marker )); then
            cp -a "$marker_backup" "$marker" || restore_ok=0
        else
            rm -f "$marker" || restore_ok=0
        fi
        if (( was_active )); then
            systemctl restart "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        else
            systemctl stop "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        fi
        rm -f "$backup" "$marker_backup"
        if (( restore_ok == 0 )); then
            printf 'ошибка: ownership marker не записан, прежнее состояние восстановить не удалось\n' >&2
        else
            printf 'ошибка: ownership marker не записан, прежнее состояние восстановлено\n' >&2
        fi
        return 1
    }
    _zf_restore_signal_traps
    rm -f "$backup" "$marker_backup"
}

cmd_status_json() {
    ZF_MACHINE_OUTPUT=1
    local st cur gf ipset fs_ver zap_ver
    st=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)
    cur=$(zf_state strategy || true)
    gf=$(zf_state gamefilter || true)
    ipset=$(zf_ipset_mode "$ZF_LISTS_DIR")
    fs_ver=""
    [[ -f "$(_zf_flowseal_ver_file)" ]] && fs_ver=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)" 2>/dev/null)
    zap_ver=$(_zf_nfqws_version 2>/dev/null || true)
    printf '{"schema_version":1,"command":"status","sonar_version":"%s","service":"%s","service_state":"%s","strategy":"%s","gamefilter":"%s","ipset":"%s","zapret":"%s","flowseal":"%s"}\n' \
        "$ZF_VERSION" "$(_zf_json_escape "$ZF_SERVICE")" "$(_zf_json_escape "$st")" "$(_zf_json_escape "${cur:-}")" \
        "$(_zf_json_escape "${gf:-}")" "$(_zf_json_escape "$ipset")" "$(_zf_json_escape "$zap_ver")" "$(_zf_json_escape "$fs_ver")"
}

cmd_status() {
    [[ "${1:-}" == "--json" ]] && { cmd_status_json; return; }
    local st cur nf_own nf_all
    st=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null)
    cur=$(zf_state strategy)
    # Считаем отдельно свои и чужие nfqws: на машине может стоять другой
    # проект (zapret-ng, zapret2), и общий счётчик вводил бы в заблуждение —
    # «1 процесс» при выключенном своём сервисе.
    nf_own=$(pgrep -c -f "^$ZF_NFQWS " 2>/dev/null || true)
    nf_all=$(pgrep -c -x nfqws 2>/dev/null || true)
    nf_own="${nf_own:-0}"; nf_all="${nf_all:-0}"

    printf 'сервис %s : %s\n' "$ZF_SERVICE" "${st:-неизвестно}"
    printf 'стратегия  : %s\n' "${cur:-не применена через zapret-sonar}"
    printf 'gamefilter : %s\n' "$(zf_state gamefilter || true)"
    printf 'ipset      : %s\n' "$(zf_ipset_mode "$ZF_LISTS_DIR")"
    printf 'zapret     : %s\n' "$(_zf_nfqws_version)"
    local fs_ver=""; [[ -f "$(_zf_flowseal_ver_file)" ]] && fs_ver=$(cat "$(_zf_flowseal_ver_file)" 2>/dev/null)
    printf 'flowseal   : %s\n' "${fs_ver:-неизвестно}"
    if (( nf_all > nf_own )); then
        printf 'nfqws      : %s наш, %s чужих (другой проект обхода)\n' "$nf_own" "$((nf_all - nf_own))"
    else
        printf 'nfqws      : %s процесс(ов)\n' "$nf_own"
    fi
    printf '\nОкружение:\n'
    zf_preflight
}

cmd_check() {
    local format="text"
    case "${1:-}" in
        "") ;;
        --json) format=v1 ;;
        --json-v2) format=v2 ;;
        *) die "check: неизвестный ключ $1" ;;
    esac
    (( $# <= 1 )) || die "check: лишние аргументы"
    if [[ "$format" != text ]]; then
        ZF_MACHINE_OUTPUT=1
        local rc include_quic=$ZF_HEALTH_INCLUDE_QUIC
        [[ "$format" == v1 ]] && ZF_HEALTH_INCLUDE_QUIC=0
        zf_health_check >/dev/null; rc=$?
        ZF_HEALTH_INCLUDE_QUIC=$include_quic
        if [[ "$format" == v1 ]]; then
            printf '{"schema_version":1,"command":"check","ok":%s,"passed":%d,"failed":%d,"skipped":%d,"scope":"http-content"}\n' \
                "$([[ $rc -eq 0 ]] && printf true || printf false)" \
                "$ZF_HEALTH_PASSED" "$ZF_HEALTH_FAILED" "$ZF_HEALTH_SKIPPED"
        else
            local first=1 result category target status reason http_code bytes speed_kbps
            local http_version curl_exit_code control_status control_target
            printf '{"schema_version":2,"command":"check","ok":%s,"summary":{"passed":%d,"failed":%d,"not_checked":%d},"scope":["http","content","speed","quic"],"checks":[' \
                "$([[ $rc -eq 0 ]] && printf true || printf false)" \
                "$ZF_HEALTH_PASSED" "$ZF_HEALTH_FAILED" "$ZF_HEALTH_NOT_CHECKED"
            for result in "${ZF_HEALTH_RESULTS[@]}"; do
                IFS=$'\t' read -r category target status reason http_code bytes speed_kbps \
                    http_version curl_exit_code control_status control_target <<< "$result"
                [[ "$http_code" =~ ^[1-5][0-9][0-9]$ ]] || http_code=""
                [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=""
                [[ "$speed_kbps" =~ ^[0-9]+$ ]] || speed_kbps=""
                [[ "$http_version" == 3 ]] || http_version=-
                [[ "$curl_exit_code" =~ ^[0-9]+$ ]] || curl_exit_code=""
                (( first )) || printf ','
                first=0
                printf '{"category":"%s","target":"%s","status":"%s","reason":"%s","http_code":%s,"bytes":%s,"speed_kbps":%s,"http_version":%s,"curl_exit_code":%s,"control_status":%s,"control_target":%s}' \
                    "$(_zf_json_escape "$category")" "$(_zf_json_escape "$target")" \
                    "$(_zf_json_escape "$status")" "$(_zf_json_escape "$reason")" \
                    "${http_code:-null}" "${bytes:-null}" "${speed_kbps:-null}" \
                    "$([[ "$http_version" == - ]] && printf null || printf '"%s"' "$(_zf_json_escape "$http_version")")" \
                    "${curl_exit_code:-null}" \
                    "$([[ "$control_status" == - ]] && printf null || printf '"%s"' "$(_zf_json_escape "$control_status")")" \
                    "$([[ "$control_target" == - ]] && printf null || printf '"%s"' "$(_zf_json_escape "$control_target")")"
            done
            printf ']}\n'
        fi
        return "$rc"
    fi
    zf_health_check
}

cmd_doctor() {
    local failed=0 st strategy gamefilter
    printf 'zapret-sonar doctor\n\n'
    printf 'Сервис: '
    st=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)
    if [[ "$st" == active ]]; then printf 'OK (%s)\n' "$st"; else printf 'FAIL (%s)\n' "${st:-unknown}"; failed=1; fi
    printf 'Конфиг: '
    if [[ -r "$ZF_ZAPRET_CONFIG" ]] && bash -n "$ZF_ZAPRET_CONFIG" 2>/dev/null; then printf 'OK\n'; else printf 'FAIL\n'; failed=1; fi
    printf 'nfqws: '
    if [[ -x "$ZF_NFQWS" ]]; then printf 'OK (%s)\n' "$(_zf_nfqws_version)"; else printf 'FAIL (%s)\n' "$ZF_NFQWS"; failed=1; fi
    printf 'Стратегии: '
    strategy=$(zf_list_strategies 2>/dev/null | wc -l)
    if (( strategy > 0 )); then printf 'OK (%s)\n' "$strategy"; else printf 'FAIL (нет .bat)\n'; failed=1; fi
    printf 'Ссылки активной стратегии: '
    strategy=$(zf_state strategy || true)
    gamefilter=$(zf_state gamefilter || true)
    if [[ -n "$strategy" ]] && zf_translate "$ZF_STRATEGIES_DIR/$strategy" "$ZF_BIN_DIR" "$ZF_LISTS_DIR" "${gamefilter:-off}" 2>/dev/null; then
        local missing=0 file
        while IFS= read -r file; do [[ -e "$file" ]] || missing=1; done < <(zf_referenced_files)
        if (( missing == 0 )) && zf_verify "$ZF_NFQWS" >/dev/null 2>&1; then printf 'OK\n'; else printf 'FAIL\n'; failed=1; fi
    else
        printf 'SKIP (стратегия не применена)\n'
    fi
    printf 'Перехват трафика: '
    if [[ "$st" != active ]]; then
        printf 'SKIP (сервис не активен)\n'
    elif (( EUID != 0 )); then
        printf 'SKIP (firewall rules требуют root)\n'
    elif ! grep -q '^# zapret-sonar-strategy: ' "$ZF_ZAPRET_CONFIG" 2>/dev/null; then
        printf 'SKIP (конфиг не управляется zapret-sonar)\n'
    else
        local fwtype qnum table rules postnat postnat_hook prenat expected
        fwtype=$(_zf_config_literal_or_default FWTYPE "") \
            || { printf 'FAIL (некорректный FWTYPE)\n'; failed=1; fwtype=invalid; }
        qnum=$(_zf_config_literal_or_default QNUM 200) \
            || { printf 'FAIL (некорректный QNUM)\n'; failed=1; qnum=invalid; fwtype=invalid; }
        table=$(_zf_config_literal_or_default ZAPRET_NFT_TABLE zapret) \
            || { printf 'FAIL (некорректная nftables table)\n'; failed=1; table=invalid; fwtype=invalid; }
        [[ -n "$fwtype" ]] || { printf 'FAIL (FWTYPE не определён)\n'; failed=1; fwtype=invalid; }
        [[ "$qnum" =~ ^[0-9]+$ && qnum -le 65535 ]] \
            || { printf 'FAIL (некорректный QNUM)\n'; failed=1; fwtype=invalid; }
        [[ "$table" =~ ^[A-Za-z0-9_.-]+$ ]] \
            || { printf 'FAIL (некорректная nftables table)\n'; failed=1; fwtype=invalid; }
        if [[ "$fwtype" != invalid ]] && ! _zf_nfqws_uses_queue "$qnum"; then
            printf 'FAIL (nfqws не слушает NFQUEUE %s)\n' "$qnum"; failed=1; fwtype=invalid
        fi
        case "$fwtype" in
            nftables)
                if ! command -v nft >/dev/null 2>&1 \
                    || ! postnat=$(nft list chain inet "$table" postnat 2>/dev/null) \
                    || ! postnat_hook=$(nft list chain inet "$table" postnat_hook 2>/dev/null) \
                    || ! prenat=$(nft list chain inet "$table" prenat 2>/dev/null); then
                    printf 'FAIL (не удалось прочитать nftables rules)\n'; failed=1
                else
                    expected='queue([^[:digit:]]|[[:space:]])*to[[:space:]]+'"$qnum"'([^[:digit:]]|$)'
                    local post_tcp post_udp pre_tcp pre_udp
                    post_tcp=$(grep -Ec "tcp .*${expected}" <<< "$postnat" || true)
                    post_udp=$(grep -Ec "udp .*${expected}" <<< "$postnat" || true)
                    pre_tcp=$(grep -Ec "tcp .*${expected}" <<< "$prenat" || true)
                    pre_udp=$(grep -Ec "udp .*${expected}" <<< "$prenat" || true)
                    if (( post_tcp == 1 && post_udp == 1 && pre_tcp == 1 && pre_udp == 1 )) \
                        && [[ "$postnat_hook" == *'hook postrouting'* && "$postnat_hook" == *'jump postnat'* \
                              && "$prenat" == *'hook prerouting'* ]]; then
                    printf 'OK (nftables, NFQUEUE %s)\n' "$qnum"
                    else
                        printf 'FAIL (неполный nftables NFQUEUE %s: postnat tcp=%s udp=%s, prenat tcp=%s udp=%s)\n' \
                            "$qnum" "$post_tcp" "$post_udp" "$pre_tcp" "$pre_udp"; failed=1
                    fi
                fi
                ;;
            iptables)
                if ! command -v iptables-save >/dev/null 2>&1 \
                    || ! rules=$(iptables-save -t mangle 2>/dev/null); then
                    printf 'FAIL (не удалось прочитать iptables rules)\n'; failed=1
                else
                    expected='-j[[:space:]]+NFQUEUE[[:space:]]+--queue-num[[:space:]]+'"$qnum"'([^[:digit:]]|$)'
                    local post_tcp post_udp input_tcp input_udp forward_tcp forward_udp
                    post_tcp=$(grep -Ec "^-A POSTROUTING -p tcp .*${expected}" <<< "$rules" || true)
                    post_udp=$(grep -Ec "^-A POSTROUTING -p udp .*${expected}" <<< "$rules" || true)
                    input_tcp=$(grep -Ec "^-A INPUT -p tcp .*${expected}" <<< "$rules" || true)
                    input_udp=$(grep -Ec "^-A INPUT -p udp .*${expected}" <<< "$rules" || true)
                    forward_tcp=$(grep -Ec "^-A FORWARD -p tcp .*${expected}" <<< "$rules" || true)
                    forward_udp=$(grep -Ec "^-A FORWARD -p udp .*${expected}" <<< "$rules" || true)
                    if (( post_tcp == 1 && post_udp == 1 && input_tcp == 1 && input_udp == 1 \
                          && forward_tcp == 1 && forward_udp == 1 )); then
                        printf 'OK (iptables, NFQUEUE %s)\n' "$qnum"
                    else
                        printf 'FAIL (неполный iptables NFQUEUE %s)\n' "$qnum"; failed=1
                    fi
                fi
                ;;
            invalid) ;;
            *)
                printf 'FAIL (неизвестный FWTYPE: %s)\n' "${fwtype:-не задан}"; failed=1
                ;;
        esac
    fi
    printf '\nИтог: %s\n' "$([[ $failed -eq 0 ]] && printf OK || printf FAIL)"
    return "$failed"
}

# Служебное: чтение состояния для TUI и скриптов.
# Состояние сервиса спрашивается через CLI, а не напрямую systemctl: имя
# юнита знает только он (может быть не «zapret», см. lib/paths.sh).
cmd_state() {
    case "${1:-strategy}" in
        service)   systemctl is-active "$ZF_SERVICE" 2>/dev/null || true ;;
        autostart) systemctl is-enabled "$ZF_SERVICE" 2>/dev/null || true ;;
        *)         zf_state "${1:-strategy}" ;;
    esac
}

# Служебное: разбор стратегии для preview в TUI. Показывает, чем варианты
# отличаются, без чтения .bat вручную. Ничего не применяет.
cmd_describe() {
    local q="${1:-}" name
    [[ -n "$q" ]] || return 1
    name=$(zf_resolve_strategy "$q" 2>/dev/null) || { printf 'не найдено: %s\n' "$q"; return 1; }

    local gf; gf=$(zf_state gamefilter); gf="${gf:-off}"
    if ! zf_translate "$ZF_STRATEGIES_DIR/$name" "$ZF_BIN_DIR" "$ZF_LISTS_DIR" "$gf" 2>/dev/null; then
        printf '%s\n\nне транслируется\n' "$name"; return 1
    fi

    printf '%s\n\n' "$name"
    [[ "$name" == "$(zf_state strategy)" ]] && printf 'применена сейчас\n\n'

    printf 'порты TCP : %s\n' "${ZF_PORTS_TCP:-—}"
    printf 'порты UDP : %s\n\n' "${ZF_PORTS_UDP:-—}"

    # Методы desync — главное отличие стратегий друг от друга.
    printf 'методы    : %s\n' \
        "$(printf '%s' "$ZF_OPT" | grep -oE -- '--dpi-desync=[a-z,]+' | sed 's/--dpi-desync=//' | sort -u | paste -sd' ' -)"
    printf 'фейки     : %s\n' \
        "$(printf '%s' "$ZF_OPT" | grep -oE -- '--dpi-desync-fake-[a-z]+' | sed 's/--dpi-desync-fake-//' | sort -u | paste -sd' ' -)"
    printf 'fooling   : %s\n' \
        "$(printf '%s' "$ZF_OPT" | grep -oE -- '--dpi-desync-fooling=[a-z,0-9]+' | sed 's/.*=//' | sort -u | paste -sd' ' -)"
    # ZF_OPT — одна длинная строка, поэтому считаем совпадения (grep -o | wc),
    # а не строки: `grep -c` перебивает `-o` и вернул бы 1.
    printf 'секций    : %s\n\n' \
        "$(( $(printf '%s' "$ZF_OPT" | grep -o -- '--new' | wc -l) + 1 ))"

    # Проверка через сам nfqws: сразу видно, применима ли стратегия вообще.
    if zf_verify "$ZF_NFQWS" 2>/dev/null; then
        printf 'nfqws --dry-run: принято\n'
    else
        printf 'nfqws --dry-run: ОТВЕРГНУТО\n'
    fi

    local missing=0 f
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -e "$f" ]] || { printf 'нет файла: %s\n' "$f"; missing=1; }
    done < <(zf_referenced_files)
    (( missing == 0 )) && printf 'файлы (списки, фейки): на месте\n'
}

# --- Перебор стратегий -------------------------------------------------------
# Главная команда: у Flowseal рабочая стратегия подбирается опытом, и это
# ровно то, что делают вручную — применил, проверил, не вышло, следующая.
#
# По умолчанию исходная стратегия возвращается в конце: инструмент не решает
# за пользователя, что «лучше». С --keep остаётся первая заработавшая.
cmd_try() {
    local keep=0 arg
    for arg in "$@"; do
        case "$arg" in
            --keep) keep=1 ;;
            *) die "try: неизвестный ключ $arg" ;;
        esac
    done

    [[ $EUID -eq 0 ]] || die "нужен root: sudo $0 try ${*:-}"
    _zf_lock

    local restore_to; restore_to=$(zf_state strategy)
    local original_active=0 original_config="" original_marker="" marker_backup="" had_marker=0 try_committed=0
    [[ "$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)" == active ]] && original_active=1
    if [[ -f "$ZF_ZAPRET_CONFIG" ]]; then
        original_config=$(mktemp "$ZF_ZAPRET_BASE/.config.try.XXXXXX") || die "не удалось сохранить текущий конфиг"
        cp -a "$ZF_ZAPRET_CONFIG" "$original_config" || { rm -f "$original_config"; die "не удалось сохранить текущий конфиг"; }
    fi
    original_marker=$(_zf_firewall_owner_file)
    if [[ -f "$original_marker" ]]; then
        marker_backup=$(mktemp "$ZF_ZAPRET_BASE/.firewall-owner.try.XXXXXX") || die "не удалось сохранить firewall ownership"
        cp -a "$original_marker" "$marker_backup" || { rm -f "$marker_backup"; die "не удалось сохранить firewall ownership"; }
        had_marker=1
    fi
    _try_restore() {
        local restore_ok=1
        if [[ -n "$original_config" && -f "$original_config" ]]; then
            cp -a "$original_config" "$ZF_ZAPRET_CONFIG" || restore_ok=0
        else
            rm -f "$ZF_ZAPRET_CONFIG" || restore_ok=0
        fi
        if (( had_marker )); then
            cp -a "$marker_backup" "$original_marker" || restore_ok=0
        else
            rm -f "$original_marker" || restore_ok=0
        fi
        if (( original_active )); then
            systemctl restart "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        else
            systemctl stop "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
        fi
        (( restore_ok ))
    }
    _try_cleanup() {
        local rc=$?
        trap - EXIT INT TERM HUP
        if (( ! try_committed )); then
            printf '\nвозвращаю исходное состояние\n'
            _try_restore || printf 'КРИТИЧНО: исходное состояние восстановить не удалось\n' >&2
        fi
        [[ -n "$original_config" ]] && rm -f "$original_config"
        [[ -n "$marker_backup" ]] && rm -f "$marker_backup"
        return "$rc"
    }
    _try_interrupted() { exit 130; }
    trap _try_cleanup EXIT
    trap _try_interrupted INT TERM HUP
    # Если конфиг не наш — предупредить: перебор перезапишет его, а исходная
    # стратегия неизвестна (нет маркера), вернуться к ней не получится.
    if [[ -z "$restore_to" && -f "$ZF_ZAPRET_CONFIG" ]]; then
        if ! grep -q "^${ZF_MARK_STRATEGY}" "$ZF_ZAPRET_CONFIG" 2>/dev/null; then
            printf 'Внимание: текущий конфиг zapret не создан zapret-sonar.\n'
            printf 'Перебор перезапишет его. Оригинал будет сохранён в config.orig.\n'
            printf 'Продолжить? [y/N] '
            local a; read -r a
            if [[ ! "$a" =~ ^[yYдД]$ ]]; then
                try_committed=1
                trap - EXIT INT TERM HUP
                [[ -n "$original_config" ]] && rm -f "$original_config"
                [[ -n "$marker_backup" ]] && rm -f "$marker_backup"
                return 0
            fi
        fi
    fi

    local gf; gf=$(zf_state gamefilter); gf="${gf:-off}"
    local ipset; ipset=$(zf_ipset_mode "$ZF_LISTS_DIR")

    # Сначала убеждаемся, что есть что проверять: если ни одна цель не
    # блокируется, все стратегии покажут «работает» и перебор бессмыслен.
    printf 'Проверка базовой линии (сервис останавливается на время замера)\n'
    systemctl stop "$ZF_SERVICE" 2>/dev/null || die "не удалось остановить сервис для baseline"
    sleep 1
    if ! zf_baseline; then
        die "перебор невозможен: нет заблокированных целей для проверки"
    fi
    printf '\n'

    local -a worked=() failed=() broke=()
    local name first_ok="" total=0
    # Короче обычного: при переборе важнее скорость, чем терпимость к
    # медленному ответу — нерабочая стратегия всё равно отпадёт.
    # shellcheck disable=SC2034 # используется в lib/health.sh через dynamic scope
    local ZF_HEALTH_TIMEOUT=5

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        total=$((total + 1))
        printf '[%2d] %-34s ' "$total" "$name"

        if ! zf_translate "$ZF_STRATEGIES_DIR/$name" "$ZF_BIN_DIR" "$ZF_LISTS_DIR" "$gf" 2>/dev/null; then
            printf 'ОШИБКА трансляции\n'; failed+=("$name"); continue
        fi
        if ! zf_verify "$ZF_NFQWS" 2>/dev/null; then
            printf 'ОШИБКА: nfqws отверг аргументы\n'; failed+=("$name"); continue
        fi
        if ! zf_write_config "$name" "$gf" "$ipset" 2>/dev/null; then
            printf 'ОШИБКА записи конфига\n'; failed+=("$name"); continue
        fi
        if ! systemctl restart "$ZF_SERVICE" 2>/dev/null; then
            printf 'ОШИБКА: сервис не поднялся\n'; failed+=("$name"); continue
        fi
        # nfqws нужно время встать и правилам примениться.
        sleep 2

        # Вердикт с контролем регрессии: стратегия, снявшая блокировку но
        # сломавшая работавшие ресурсы, рабочей не считается.
        local rc
        zf_score_strategy; rc=$?
        case $rc in
            0)
                worked+=("$name")
                [[ -z "$first_ok" ]] && first_ok="$name"
                if (( keep )); then
                    printf '\n--keep: оставляю %s\n' "$name"
                    _zf_record_firewall_ownership || die "не удалось записать firewall ownership"
                    try_committed=1
                    trap - EXIT INT TERM HUP
                    [[ -n "$original_config" ]] && rm -f "$original_config"
                    [[ -n "$marker_backup" ]] && rm -f "$marker_backup"
                    return 0
                fi ;;
            2) broke+=("$name") ;;
            *) failed+=("$name") ;;
        esac
    done < <(zf_list_strategies)

    printf '\n---\nРаботают (%d из %d):\n' "${#worked[@]}" "$total"
    if (( ${#worked[@]} == 0 )); then
        printf '  ни одна\n'
        printf '\nПроверьте Secure DNS и туннели (zapret-sonar status), затем повторите.\n'
    else
        printf '  %s\n' "${worked[@]}"
    fi

    # Отдельным списком: они снимают блокировку, но ломают то, что работало.
    # Знать о них полезно — при других условиях могут подойти.
    if (( ${#broke[@]} > 0 )); then
        printf '\nСнимают блокировку, но ломают доступное (%d):\n' "${#broke[@]}"
        printf '  %s\n' "${broke[@]}"
    fi

    if (( keep == 0 )); then
        printf '\nвозвращаю исходное состояние%s\n' "${restore_to:+: $restore_to}"
        _try_restore || die "не удалось восстановить исходное состояние"
        try_committed=1
        trap - EXIT INT TERM HUP
        [[ -n "$original_config" ]] && rm -f "$original_config"
        [[ -n "$marker_backup" ]] && rm -f "$marker_backup"
        (( ${#worked[@]} > 0 )) && printf 'применить: zapret-sonar use "%s"\n' "${worked[0]}"
    fi
    (( ${#worked[@]} > 0 ))
}
cmd_baseline() {
    local st; st=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)
    if [[ "$st" == "active" && $EUID -ne 0 ]]; then
        _zf_sudo_self _baseline
        return $?
    fi
    if [[ "$st" != "active" ]]; then
        zf_baseline
        return $?
    fi

    _zf_lock
    printf 'Сервис активен: останавливаю его на время замера базовой линии.\n\n'
    systemctl stop "$ZF_SERVICE" || die "не удалось остановить сервис для baseline"
    _zf_baseline_interrupted() {
        systemctl start "$ZF_SERVICE" >/dev/null 2>&1 || true
        exit 130
    }
    trap _zf_baseline_interrupted INT TERM HUP
    local rc=0 restart_rc=0
    zf_baseline || rc=$?
    systemctl start "$ZF_SERVICE" || restart_rc=$?
    trap - INT TERM HUP
    (( restart_rc == 0 )) || die "baseline завершён, но сервис не удалось запустить снова"
    printf '\nСервис восстановлен.\n'
    return "$rc"
}

cmd_gamefilter() {
    local mode="${1:-}" cur
    cur=$(zf_state gamefilter); cur="${cur:-off}"
    if [[ -z "$mode" ]]; then printf '%s\n' "$cur"; return 0; fi
    case "$mode" in off|tcp|udp|both) ;; *) die "режим: off|tcp|udp|both" ;; esac
    local name; name=$(zf_state strategy)
    [[ -n "$name" ]] || die "сначала примените стратегию: zapret-sonar use <имя>"
    if need_root; then
        cmd_apply "$name" "$mode" "$(zf_ipset_mode "$ZF_LISTS_DIR")"
    else
        _zf_sudo_self _apply "$name" "$mode" "$(zf_ipset_mode "$ZF_LISTS_DIR")" || exit 1
    fi
    printf 'gamefilter: %s -> %s\n' "$cur" "$mode"
}

cmd_ipset() {
    local mode="${1:-}" cur
    cur=$(zf_ipset_mode "$ZF_LISTS_DIR")
    if [[ -z "$mode" ]]; then printf '%s\n' "$cur"; return 0; fi
    case "$mode" in
        none|any|loaded) ;;
        *) die "режим: none|any|loaded (any ломает доступ к обычным сайтам)" ;;
    esac
    if need_root; then
        cmd_ipset_set "$mode" || exit 1
    else
        _zf_sudo_self _ipset_set "$mode" || exit 1
    fi
    printf 'ipset: %s -> %s (перезапустите: zapret-sonar restart)\n' "$cur" "$mode"
}

cmd_ipset_set() {
    _zf_require_root _ipset_set
    _zf_lock
    zf_set_ipset_mode "$ZF_LISTS_DIR" "$1"
}

# Управление пользовательским списком доменов. Поддомены Flowseal учитывает
# автоматически, поэтому достаточно домена второго уровня.
cmd_site() {
    local arg="${1:-}" f="$ZF_LISTS_DIR/list-general-user.txt"

    case "$arg" in
        --list)
            if [[ -f "$f" ]]; then
                tr -d '\r' < "$f" 2>/dev/null | grep -v '^#' | grep . || printf '(список пуст)\n'
            else
                printf '(список пуст)\n'
            fi
            return 0 ;;
        --remove)
            local target="${2:-}"
            [[ -n "$target" ]] || die "укажите домен: site --remove <домен>"
            target="${target#http://}"; target="${target#https://}"; target="${target%%/*}"
            target="${target,,}"
            [[ -f "$f" ]] || { printf 'список пуст\n'; return 0; }
            if ! tr -d '\r' < "$f" 2>/dev/null | grep -qxF "$target"; then
                printf 'не найден в списке: %s\n' "$target"; return 0
            fi
            if [[ $EUID -eq 0 ]]; then
                cmd_site_mutate remove "$target"
            else
                _zf_sudo_self _site_remove "$target" || exit 1
            fi
            printf 'удалён: %s (перезапустите: zapret-sonar restart)\n' "$target"
            return 0 ;;
    esac

    local domain="$arg"
    [[ -n "$domain" ]] || die "укажите домен (или --list / --remove <домен>)"
    domain="${domain#http://}"; domain="${domain#https://}"; domain="${domain%%/*}"
    domain="${domain,,}"
    [[ "$domain" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "не похоже на домен: $domain"
    if tr -d '\r' < "$f" 2>/dev/null | grep -qxF "$domain"; then
        printf 'уже в списке: %s\n' "$domain"; return 0
    fi
    if [[ $EUID -eq 0 ]]; then
        cmd_site_mutate add "$domain"
    else
        _zf_sudo_self _site_add "$domain" || exit 1
    fi
    printf 'добавлен: %s (перезапустите: zapret-sonar restart)\n' "$domain"
}

cmd_site_mutate() {
    local action="$1" domain="$2" f="$ZF_LISTS_DIR/list-general-user.txt" tmp
    [[ $EUID -eq 0 ]] || die "изменение списка требует root"
    _zf_lock
    case "$action" in
        add)
            printf '%s\n' "$domain" >> "$f" || die "не удалось записать $f"
            ;;
        remove)
            tmp=$(mktemp "$ZF_LISTS_DIR/list-general-user.XXXXXX") || die "не удалось создать временный файл"
            tr -d '\r' < "$f" | grep -vxF "$domain" > "$tmp" || true
            chmod --reference="$f" "$tmp" 2>/dev/null || chmod 644 "$tmp"
            chown --reference="$f" "$tmp" 2>/dev/null || true
            mv -f "$tmp" "$f" || { rm -f "$tmp"; die "не удалось записать $f"; }
            ;;
        *) die "неизвестная операция со списком: $action" ;;
    esac
}

# --- Обновление Flowseal (стратегии, списки, .bin) ---------------------------
# Скачивает релиз Flowseal с GitHub, обновляет .bat, .bin и списки доменов.
# Пользовательские *-user.txt никогда не затираются.
# Проверяет версию через GitHub API: если последняя совпадает с установленной,
# пропускает (если не --force).
cmd_update() {
    local force=0 arg
    for arg in "$@"; do
        case "$arg" in --force) force=1 ;; *) die "update: неизвестный ключ $arg" ;; esac
    done

    if ! need_root; then
        local rc
        if (( force )); then
            _zf_sudo_self _update --force; rc=$?
        else
            _zf_sudo_self _update; rc=$?
        fi
        (( rc == 0 )) && _zf_invalidate_update_caches
        return "$rc"
    fi

    _zf_lock

    local cur="" old_version=""
    [[ -f "$(_zf_flowseal_ver_file)" ]] && cur=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)" 2>/dev/null)
    old_version="$cur"
    cur="${cur#v}"
    printf 'Flowseal: установлена %s\n' "${cur:-неизвестно}"

    printf 'Проверка GitHub...\n'
    local latest; latest=$(_zf_github_latest_tag "Flowseal/zapret-discord-youtube" | tr -d '[:space:]')
    latest="${latest#v}"
    if [[ -z "$latest" ]]; then
        printf '  не удалось получить версию — обновляю без проверки\n'
    else
        printf '  последняя: %s\n' "$latest"
        if (( force == 0 )) && [[ -n "$cur" ]] && ! _zf_version_is_newer "$latest" "$cur"; then
            printf 'уже актуально\n'
            return 0
        fi
    fi

    local tmp_dir url
    tmp_dir=$(mktemp -d) || die "не удалось создать временную директорию"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir'" EXIT

    if [[ -n "$latest" ]]; then
        url="https://github.com/Flowseal/zapret-discord-youtube/archive/refs/tags/$latest.tar.gz"
    else
        url="https://github.com/flowseal/zapret-discord-youtube/archive/refs/heads/main.zip"
    fi

    printf 'Скачивание %s...\n' "${latest:-main branch}"
    if ! curl -fsSL -m 60 -o "$tmp_dir/flowseal.archive" "$url"; then
        die "не удалось скачать архив с GitHub (возможно 404 — релиз недоступен)"
    fi

    # Релизы — .tar.gz, main branch — .zip. Пробуем оба.
    if ! tar -xzf "$tmp_dir/flowseal.archive" -C "$tmp_dir" 2>/dev/null; then
        if ! unzip -q "$tmp_dir/flowseal.archive" -d "$tmp_dir" 2>/dev/null; then
            die "ошибка распаковки архива"
        fi
    fi

    local src_dir
    src_dir=$(find "$tmp_dir" -maxdepth 2 -name 'general*.bat' -printf '%h\n' 2>/dev/null | head -1)
    [[ -n "$src_dir" ]] || die "в архиве не найдено стратегий general*.bat"
    [[ -d "$src_dir/bin" && -d "$src_dir/lists" ]] || die "в архиве Flowseal нет bin/ или lists/"

    printf 'Подготовка нового набора Flowseal в staging...\n'
    local old_lists="$ZF_LISTS_DIR"
    local stage="$ZF_ZAPRET_BASE/.flowseal-stage.$$"
    local release
    release="$ZF_ZAPRET_BASE/.flowseal-releases/${latest:-main}-$(date +%s)-$$"
    rm -rf "$stage"
    zf_prepare_flowseal_tree "$src_dir" "$stage" "$old_lists" \
        || die "не удалось подготовить новый набор Flowseal"
    zf_validate_flowseal_tree "$stage" \
        || die "новый набор Flowseal не прошёл проверку стратегий"
    local current="$ZF_ZAPRET_BASE/flowseal-current" old_target=""
    [[ -L "$current" ]] && old_target=$(readlink "$current")
    if [[ -n "$old_target" && -n "$old_version" && ! -f "$ZF_ZAPRET_BASE/$old_target/.flowseal-release" ]]; then
        zf_write_flowseal_metadata "$ZF_ZAPRET_BASE/$old_target" "$ZF_ZAPRET_BASE/.flowseal-releases" "${old_version#v}" \
            || die "не удалось записать metadata предыдущего Flowseal release"
    fi
    local update_pending=0 update_committed=0 cur_strat="" gf="off" ips="none"
    # Signal traps pass the optional signal name.
    # shellcheck disable=SC2120
    _zf_update_rollback() {
        local signal="${1:-}"
        local restore_ok=1
        if (( update_pending && ! update_committed )); then
            if [[ -n "$old_target" ]] && zf_restore_flowseal_tree "$current" "$old_target"; then
                ZF_STRATEGIES_DIR="$current/strategies"
                ZF_BIN_DIR="$current/bin"
                ZF_LISTS_DIR="$current/lists"
                if [[ -n "$cur_strat" ]] && ! cmd_apply "$cur_strat" "$gf" "$ips" >/dev/null 2>&1; then restore_ok=0; fi
            else
                restore_ok=0
            fi
            if [[ -d "$release" ]] && ! zf_remove_flowseal_release "$ZF_ZAPRET_BASE/.flowseal-releases" "$release" >/dev/null 2>&1; then restore_ok=0; fi
            if [[ -n "$old_version" ]]; then
                printf '%s\n' "$old_version" > "$(_zf_flowseal_ver_file)" || restore_ok=0
            else
                rm -f "$(_zf_flowseal_ver_file)" || restore_ok=0
            fi
        fi
        if [[ -n "$signal" ]]; then
            (( restore_ok )) || printf 'КРИТИЧНО: обновление прервано, прежнее состояние восстановлено не полностью\n' >&2
            case "$signal" in INT) exit 130 ;; TERM) exit 143 ;; HUP) exit 129 ;; esac
        fi
        (( restore_ok ))
    }
    trap '_zf_update_rollback INT' INT
    trap '_zf_update_rollback TERM' TERM
    trap '_zf_update_rollback HUP' HUP
    update_pending=1
    zf_activate_flowseal_tree "$stage" "$release" "$current" \
        || die "не удалось атомарно активировать новый набор Flowseal"
    ZF_STRATEGIES_DIR="$ZF_ZAPRET_BASE/flowseal-current/strategies"
    ZF_BIN_DIR="$ZF_ZAPRET_BASE/flowseal-current/bin"
    ZF_LISTS_DIR="$ZF_ZAPRET_BASE/flowseal-current/lists"
    chown -R root:root "$release"
    if ! zf_write_flowseal_metadata "$release" "$ZF_ZAPRET_BASE/.flowseal-releases" "${latest:-main}"; then
        _zf_update_rollback || true
        die "не удалось записать metadata Flowseal release; предыдущий набор восстановлен"
    fi
    printf '  • стратегии, .bin и списки переключены одним набором\n'

    # Конфиг и сервис проверяются до фиксации версии и удаления snapshots.
    cur_strat=$(zf_state strategy)
    if [[ -n "$cur_strat" ]]; then
        gf=$(zf_state gamefilter); gf="${gf:-off}"
        ips=$(zf_ipset_mode "$ZF_LISTS_DIR")
        printf 'Пересборка конфига (%s)...\n' "$cur_strat"
        if [[ ! -f "$ZF_STRATEGIES_DIR/$cur_strat" ]] || ! cmd_apply "$cur_strat" "$gf" "$ips"; then
            if [[ -z "$old_target" ]] || ! zf_restore_flowseal_tree "$current" "$old_target"; then
                die "обновление не применилось, автоматический откат набора Flowseal не удался"
            fi
            ZF_STRATEGIES_DIR="$current/strategies"
            ZF_BIN_DIR="$current/bin"
            ZF_LISTS_DIR="$current/lists"
            if ! cmd_apply "$cur_strat" "$gf" "$ips" >/dev/null 2>&1; then
                die "старый набор Flowseal возвращён, но рабочий конфиг/сервис восстановить не удалось"
            fi
            zf_remove_flowseal_release "$ZF_ZAPRET_BASE/.flowseal-releases" "$release" \
                || die "старый набор восстановлен, но не удалось удалить нерабочий snapshot"
            [[ -n "$old_version" ]] && printf '%s\n' "$old_version" > "$(_zf_flowseal_ver_file)"
            die "не удалось применить активную стратегию, старый набор Flowseal восстановлен"
        fi
    fi

    local version_tmp
    version_tmp=$(mktemp "$ZF_ZAPRET_BASE/.flowseal-version.XXXXXX") || die "не удалось записать версию Flowseal"
    printf '%s\n' "${latest:-main}" > "$version_tmp"
    chmod 644 "$version_tmp" && mv -f "$version_tmp" "$(_zf_flowseal_ver_file)" \
        || { rm -f "$version_tmp"; _zf_update_rollback; die "не удалось зафиксировать версию Flowseal"; }
    update_committed=1
    trap - INT TERM HUP

    # Только подтверждённый новый набор и предыдущий рабочий остаются на диске.
    zf_prune_flowseal_releases "$ZF_ZAPRET_BASE/.flowseal-releases" "$release" "$old_target" \
        || die "обновление применено, но не удалось очистить старые snapshots"
    _zf_invalidate_update_caches

    printf '\nОбновление Flowseal завершено'
    [[ -n "$latest" ]] && printf ' (версия %s)' "$latest"
    printf '.\n'
}

cmd_snapshots() {
    local json=0 arg releases="$ZF_ZAPRET_BASE/.flowseal-releases" current_target="" release id state version created first=1
    for arg in "$@"; do case "$arg" in --json) json=1 ;; *) die "snapshots: неизвестный ключ $arg" ;; esac; done
    [[ -d "$releases" && ! -L "$releases" ]] || die "каталог snapshots не найден"
    [[ -L "$ZF_FLOWSEAL_CURRENT" ]] && current_target=$(basename "$(readlink "$ZF_FLOWSEAL_CURRENT")")
    (( json )) && { ZF_MACHINE_OUTPUT=1; printf '{"schema_version":1,"command":"snapshots","snapshots":['; }
    for release in "$releases"/*; do
        [[ -d "$release" && ! -L "$release" ]] || continue
        id=$(zf_flowseal_release_id "$release" "$releases") || continue
        [[ "$id" == "$current_target" ]] && state=current || state=rollback
        version=$(zf_read_flowseal_metadata "$release" flowseal_version 2>/dev/null || true)
        created=$(zf_read_flowseal_metadata "$release" created_at 2>/dev/null || true)
        if (( json )); then
            (( first )) || printf ','; first=0
            printf '{"id":"%s","state":"%s","flowseal_version":%s,"created_at":%s}' \
                "$(_zf_json_escape "$id")" "$state" \
                "$([[ -n "$version" ]] && printf '"%s"' "$version" || printf null)" \
                "$([[ -n "$created" ]] && printf '"%s"' "$created" || printf null)"
        else
            printf '%-9s %-42s %-12s %s\n' "$state" "$id" "${version:--}" "${created:--}"
        fi
    done
    (( json )) && printf ']}\n'
}

cmd_snapshot_ids() {
    local releases="$ZF_ZAPRET_BASE/.flowseal-releases" current_target="" release id
    [[ -L "$ZF_FLOWSEAL_CURRENT" ]] && current_target=$(basename "$(readlink "$ZF_FLOWSEAL_CURRENT")")
    for release in "$releases"/*; do
        [[ -d "$release" && ! -L "$release" ]] || continue
        id=$(zf_flowseal_release_id "$release" "$releases") || continue
        [[ "$id" == "$current_target" ]] || printf '%s\n' "$id"
    done
}

cmd_rollback() {
    local requested="${1:-}" releases="$ZF_ZAPRET_BASE/.flowseal-releases"
    if ! need_root; then _zf_sudo_self _rollback "$requested"; return $?; fi
    _zf_lock
    local current="$ZF_FLOWSEAL_CURRENT" current_target target release id count=0
    [[ -L "$current" ]] || die "активный snapshot не найден"
    current_target=$(readlink "$current")
    for release in "$releases"/*; do
        [[ -d "$release" && ! -L "$release" ]] || continue
        id=$(zf_flowseal_release_id "$release" "$releases") || continue
        [[ "$id" == "$(basename "$current_target")" ]] && continue
        if [[ -n "$requested" ]]; then [[ "$id" == "$requested" ]] || continue; fi
        target="$release"; count=$((count + 1))
    done
    (( count == 1 )) || die "$([[ $count -eq 0 ]] && printf 'snapshot не найден' || printf 'укажите snapshot явно: sonar snapshots')"
    zf_validate_flowseal_tree "$target" || die "snapshot не прошёл проверку стратегий"
    local strategy gf ips old_version="" new_version="" service_was_active=0
    [[ "$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)" == active ]] && service_was_active=1
    strategy=$(zf_state strategy); gf=$(zf_state gamefilter); gf="${gf:-off}"; ips=$(zf_ipset_mode "$ZF_LISTS_DIR")
    [[ -n "$strategy" && -f "$target/strategies/$strategy" ]] || die "активной стратегии нет в выбранном snapshot"
    [[ -f "$(_zf_flowseal_ver_file)" ]] && old_version=$(tr -d '[:space:]' < "$(_zf_flowseal_ver_file)")
    new_version=$(zf_read_flowseal_metadata "$target" flowseal_version 2>/dev/null || true)
    [[ -n "$new_version" ]] || die "у snapshot нет metadata версии"
    local user_file name
    for user_file in "$ZF_LISTS_DIR"/*-user.txt; do
        [[ -f "$user_file" ]] || continue
        name=$(basename "$user_file")
        install -m 644 "$user_file" "$target/lists/$name" || die "не удалось перенести пользовательский список"
    done
    zf_set_ipset_mode "$target/lists" "$ips" 0 || die "не удалось перенести режим ipset"
    # Signal traps pass the optional signal name.
    # shellcheck disable=SC2120
    _zf_rollback_restore_original() {
        local restore_ok=1 signal="${1:-}"
        trap - INT TERM HUP
        if ! zf_restore_flowseal_tree "$current" "$current_target" >/dev/null 2>&1; then
            restore_ok=0
        else
            ZF_STRATEGIES_DIR="$current/strategies"; ZF_BIN_DIR="$current/bin"; ZF_LISTS_DIR="$current/lists"
            if (( service_was_active )); then
                cmd_apply "$strategy" "$gf" "$ips" >/dev/null 2>&1 || restore_ok=0
            else
                cmd_render "$strategy" "$gf" "$ips" >/dev/null 2>&1 || restore_ok=0
                systemctl stop "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
            fi
        fi
        if [[ -n "$old_version" ]]; then
            printf '%s\n' "$old_version" > "$(_zf_flowseal_ver_file)" || restore_ok=0
        else
            rm -f "$(_zf_flowseal_ver_file)" || restore_ok=0
        fi
        if [[ -n "$signal" ]]; then
            (( restore_ok )) || printf 'КРИТИЧНО: исходный snapshot восстановлен не полностью\n' >&2
            case "$signal" in INT) exit 130 ;; TERM) exit 143 ;; HUP) exit 129 ;; esac
        fi
        (( restore_ok ))
    }
    trap '_zf_rollback_restore_original INT' INT
    trap '_zf_rollback_restore_original TERM' TERM
    trap '_zf_rollback_restore_original HUP' HUP
    if ! zf_restore_flowseal_tree "$current" ".flowseal-releases/$(basename "$target")"; then die "не удалось переключить snapshot"; fi
    ZF_STRATEGIES_DIR="$current/strategies"; ZF_BIN_DIR="$current/bin"; ZF_LISTS_DIR="$current/lists"
    local apply_ok=0
    if (( service_was_active )); then cmd_apply "$strategy" "$gf" "$ips" && apply_ok=1
    else cmd_render "$strategy" "$gf" "$ips" && apply_ok=1; fi
    if (( ! apply_ok )); then
        _zf_rollback_restore_original || die "rollback не применился, исходный snapshot восстановить не удалось"
        die "rollback не применился, исходный snapshot восстановлен"
    fi
    local version_tmp
    version_tmp=$(mktemp "$ZF_ZAPRET_BASE/.flowseal-version.XXXXXX") || { _zf_rollback_restore_original; die "не удалось записать версию snapshot"; }
    printf '%s\n' "$new_version" > "$version_tmp"
    chmod 644 "$version_tmp" && mv -f "$version_tmp" "$(_zf_flowseal_ver_file)" \
        || { rm -f "$version_tmp"; _zf_rollback_restore_original; die "не удалось записать версию snapshot; исходное состояние восстановлено"; }
    trap - INT TERM HUP
    zf_prune_flowseal_releases "$releases" "$target" "$current_target" || die "snapshot применён, но pruning завершился ошибкой"
    _zf_invalidate_update_caches
    printf 'Flowseal переключён: %s -> %s\n' "${old_version:-неизвестно}" "$new_version"
}

cmd_self_update() {
    local force=0 requested="" arg
    while (( $# )); do
        arg="$1"; shift
        case "$arg" in
            --force) force=1 ;;
            --version) [[ $# -gt 0 ]] || die "self-update: после --version нужна версия"; requested="${1#v}"; shift ;;
            *) die "self-update: неизвестный ключ $arg" ;;
        esac
    done
    [[ -L "$ZF_INSTALL_ROOT/current" && -d "$ZF_INSTALL_ROOT/releases" ]] \
        || die "self-update доступен после установки v1.3.0 через install.sh"
    if ! need_root; then
        local -a args=(_self_update)
        (( force )) && args+=(--force)
        [[ -n "$requested" ]] && args+=(--version "$requested")
        _zf_sudo_self "${args[@]}"
        return $?
    fi
    _zf_lock
    local version="$requested"
    [[ -n "$version" ]] || version=$(_zf_github_latest_tag "$ZF_SELF_REPO" | tr -d '[:space:]')
    version="${version#v}"
    zf_self_validate_version "$version" || die "не удалось определить корректную версию zapret-sonar"
    if (( force == 0 )) && ! _zf_version_is_newer "$version" "$ZF_VERSION"; then
        printf 'zapret-sonar уже актуален (%s)\n' "$ZF_VERSION"
        return 0
    fi
    local tmp asset sums_url asset_url expected_sha release_id release_dir old_target=""
    tmp=$(mktemp -d) || die "не удалось создать временную директорию"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT
    asset="zapret-sonar-v$version.tar.gz"
    asset_url="https://github.com/$ZF_SELF_REPO/releases/download/v$version/$asset"
    sums_url="https://github.com/$ZF_SELF_REPO/releases/download/v$version/SHA256SUMS"
    printf 'Скачивание zapret-sonar %s...\n' "$version"
    curl -fsSL --retry 2 -o "$tmp/$asset" "$asset_url" || die "не скачался $asset"
    curl -fsSL --retry 2 -o "$tmp/SHA256SUMS" "$sums_url" || die "не скачался SHA256SUMS"
    zf_self_verify_checksum "$tmp/SHA256SUMS" "$tmp/$asset" "$asset" || die "checksum self-update не совпал"
    zf_self_validate_archive "$tmp/$asset" "$version" || die "release archive имеет неожиданную структуру"
    mkdir -p "$tmp/tree"
    tar -xzf "$tmp/$asset" --strip-components=1 --no-same-owner --no-same-permissions -C "$tmp/tree" \
        || die "не удалось распаковать release archive"
    zf_self_validate_tree "$tmp/tree" "$version" || die "release tree не прошёл проверку"
    expected_sha=$(sha256sum "$tmp/$asset" | cut -c1-12)
    release_id="$version-$expected_sha"
    release_dir="$ZF_INSTALL_ROOT/releases/$release_id"
    local current_id=""
    [[ -L "$ZF_INSTALL_ROOT/current" ]] && current_id=$(basename "$(readlink "$ZF_INSTALL_ROOT/current")")
    if [[ "$current_id" == "$release_id" ]]; then
        zf_self_validate_tree "$release_dir" "$version" || die "активный release повреждён; переустановите через install.sh"
        printf 'zapret-sonar %s уже установлен и совпадает с release asset\n' "$version"
        rm -rf "$tmp"; trap - EXIT
        return 0
    fi
    [[ ! -e "$release_dir" && ! -L "$release_dir" ]] || rm -rf -- "$release_dir"
    mv "$tmp/tree" "$release_dir" || die "не удалось установить release tree"
    chmod 755 "$release_dir/zapret-sonar" "$release_dir/zapret-sonar-tui"
    chmod 644 "$release_dir/RELEASE" "$release_dir/lib/"*.sh
    chown -R root:root "$release_dir"
    if ! ZF_LIBRARY_MODE=0 ZF_INSTALL_ROOT="$ZF_INSTALL_ROOT" "$release_dir/zapret-sonar" --version \
        | grep -qx "zapret-sonar $version"; then
        rm -rf -- "$release_dir"
        die "новая версия не запускается"
    fi
    old_target=$(readlink "$ZF_INSTALL_ROOT/current")
    local switched=0
    _zf_self_update_interrupted() {
        trap - INT TERM HUP
        (( switched )) && zf_self_switch "$ZF_INSTALL_ROOT" "${old_target#releases/}" >/dev/null 2>&1 || true
        case "$1" in INT) exit 130 ;; TERM) exit 143 ;; HUP) exit 129 ;; esac
    }
    trap '_zf_self_update_interrupted INT' INT
    trap '_zf_self_update_interrupted TERM' TERM
    trap '_zf_self_update_interrupted HUP' HUP
    zf_self_switch "$ZF_INSTALL_ROOT" "$release_id" || die "не удалось активировать zapret-sonar $version"
    switched=1
    if ! ZF_LIBRARY_MODE=0 "$ZF_INSTALL_ROOT/zapret-sonar" --version | grep -qx "zapret-sonar $version"; then
        zf_self_switch "$ZF_INSTALL_ROOT" "${old_target#releases/}" \
            || die "post-check self-update не прошёл, предыдущую версию восстановить не удалось"
        rm -rf -- "$release_dir"
        die "post-check self-update не прошёл, предыдущая версия восстановлена"
    fi
    local previous_tmp="$ZF_INSTALL_ROOT/.previous.$$"
    ln -s "$old_target" "$previous_tmp" && mv -Tf "$previous_tmp" "$ZF_INSTALL_ROOT/previous" \
        || { rm -f "$previous_tmp"; zf_self_switch "$ZF_INSTALL_ROOT" "${old_target#releases/}" \
            || die "не удалось зафиксировать previous и восстановить предыдущую версию"; die "не удалось зафиксировать previous; предыдущая версия восстановлена"; }
    switched=0
    trap - INT TERM HUP
    zf_self_prune "$ZF_INSTALL_ROOT" "$release_id" "${old_target#releases/}" \
        || printf 'ПРЕДУПРЕЖДЕНИЕ: не удалось очистить старые версии\n' >&2
    _zf_invalidate_update_caches
    rm -rf "$tmp"
    trap - EXIT
    printf 'zapret-sonar обновлён: %s -> %s\n' "$ZF_VERSION" "$version"
}

# --- Обновление движка zapret (nfqws, ip2net, mdig) --------------------------
# Скачивает релиз zapret от bol-van с GitHub, проверяет sha256 бинарников,
# заменяет nfqws/ip2net/mdig и перезапускает сервис.
cmd_upgrade() {
    local force=0 arg
    for arg in "$@"; do
        case "$arg" in --force) force=1 ;; *) die "upgrade: неизвестный ключ $arg" ;; esac
    done

    [[ -x "$ZF_NFQWS" ]] || die "nfqws не найден: $ZF_NFQWS"
    local cur; cur=$(_zf_nfqws_version)
    printf 'zapret: установлена %s\n' "$cur"

    printf 'Проверка GitHub...\n'
    local latest; latest=$(_zf_github_latest_tag "bol-van/zapret")
    [[ -n "$latest" ]] || die "не удалось получить версию zapret с GitHub"
    printf '  последняя: %s\n' "$latest"

    # Извлекаем версию из вывода nfqws --version (например, "github version v72.13 (hash)").
    # Сравниваем через sort -V: если latest не новее cur — уже актуально.
    local cur_num latest_num
    cur_num=$(printf '%s' "$cur" | grep -oE 'v[0-9]+\.[0-9]+' | head -1)
    latest_num="$latest"
    if (( force == 0 )) && [[ -n "$cur_num" ]]; then
        if [[ "$(printf '%s\n%s\n' "$latest_num" "$cur_num" | sort -V | tail -1)" == "$cur_num" ]]; then
            printf 'уже актуально\n'
            return 0
        fi
    fi

    if ! need_root; then
        local rc
        _zf_sudo_self _upgrade "$latest"; rc=$?
        (( rc == 0 )) && _zf_invalidate_update_caches
        return "$rc"
    fi

    cmd_do_upgrade "$latest"
}

# Внутренняя: фактическое обновление, от root.
cmd_do_upgrade() {
    local latest="$1" arch tmp_dir url sums
    _zf_require_root _upgrade
    _zf_lock
    arch=$(_zf_detect_arch)

    tmp_dir=$(mktemp -d) || die "не удалось создать временную директорию"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir'" EXIT

    url="https://github.com/bol-van/zapret/releases/download/$latest/zapret-$latest.tar.gz"
    sums="https://github.com/bol-van/zapret/releases/download/$latest/sha256sum.txt"

    printf 'Скачивание zapret %s (%s)...\n' "$latest" "$arch"
    if ! curl -fsSL --retry 2 -o "$tmp_dir/zapret.tar.gz" "$url"; then
        die "не скачался zapret"
    fi
    if ! curl -fsSL --retry 2 -o "$tmp_dir/sha256sum.txt" "$sums"; then
        die "не скачался sha256sum.txt"
    fi

    tar -xzf "$tmp_dir/zapret.tar.gz" -C "$tmp_dir" || die "архив zapret не распаковался"
    local root="$tmp_dir/zapret-$latest"
    [[ -d "$root" ]] || die "в архиве нет каталога zapret-$latest"

    printf 'Проверка целостности (sha256)...\n'
    ( cd "$tmp_dir" && sha256sum -c --ignore-missing --quiet sha256sum.txt 2>/dev/null ) \
        || die "sha256 не совпал — бинарники повреждены или подменены"
    grep -Eq "^[[:xdigit:]]{64}[[:space:]]+\\*?zapret-${latest}/binaries/${arch}/nfqws$" "$tmp_dir/sha256sum.txt" \
        || die "в sha256sum.txt нет записи для $arch/nfqws — целостность не подтверждена"
    printf '  sha256 подтверждён\n'

    local binary name
    for name in nfqws ip2net mdig; do
        binary="$root/binaries/$arch/$name"
        [[ -f "$binary" ]] || die "в релизе нет бинарника для $arch/$name"
        grep -Eq "^[[:xdigit:]]{64}[[:space:]]+\\*?zapret-${latest}/binaries/${arch}/${name}$" "$tmp_dir/sha256sum.txt" \
            || die "в sha256sum.txt нет записи для $arch/$name — целостность не подтверждена"
    done

    local nfqws_bin="$root/binaries/$arch/nfqws"

    local service_was_active=0 service_state
    service_state=$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)
    case "$service_state" in
        active) service_was_active=1 ;;
        inactive|failed|unknown|'') ;;
        *) die "сервис находится в переходном состоянии: $service_state; повторите позже" ;;
    esac
    _zf_restore_engine() {
        local restore_ok=1
        install -Dm755 "$bak_dir/nfqws.old" "$ZF_NFQWS" || restore_ok=0
        install -Dm755 "$bak_dir/ip2net.old" "$ZF_ZAPRET_BASE/ip2net/ip2net" || restore_ok=0
        install -Dm755 "$bak_dir/mdig.old" "$ZF_ZAPRET_BASE/mdig/mdig" || restore_ok=0
        if (( service_was_active )); then
            systemctl start "$ZF_SERVICE" 2>/dev/null || restore_ok=0
        else
            systemctl stop "$ZF_SERVICE" 2>/dev/null || restore_ok=0
        fi
        (( restore_ok ))
    }

    printf 'Обновление бинарников в %s...\n' "$ZF_ZAPRET_BASE"
    local old_ver; old_ver=$(_zf_nfqws_version)

    # Бэкап старых бинарников: если новый не запустится — можно откатить.
    local bak_dir="$ZF_ZAPRET_BASE/.bak"
    mkdir -p "$bak_dir" || die "не удалось создать каталог отката"
    cp -a "$ZF_NFQWS" "$bak_dir/nfqws.old" || die "не удалось сохранить nfqws для отката"
    cp -a "$ZF_ZAPRET_BASE/ip2net/ip2net" "$bak_dir/ip2net.old" || die "не удалось сохранить ip2net для отката"
    cp -a "$ZF_ZAPRET_BASE/mdig/mdig" "$bak_dir/mdig.old" || die "не удалось сохранить mdig для отката"

    _zf_upgrade_interrupted() {
        trap - INT TERM HUP
        _zf_restore_engine >/dev/null 2>&1 || true
        exit 130
    }
    trap _zf_upgrade_interrupted INT TERM HUP
    if (( service_was_active )); then
        printf '  останавливаю сервис...\n'
        systemctl stop "$ZF_SERVICE" 2>/dev/null || die "не удалось остановить сервис"
    fi

    if ! install -Dm755 "$nfqws_bin" "$ZF_NFQWS" \
        || ! install -Dm755 "$root/binaries/$arch/ip2net" "$ZF_ZAPRET_BASE/ip2net/ip2net" \
        || ! install -Dm755 "$root/binaries/$arch/mdig" "$ZF_ZAPRET_BASE/mdig/mdig"; then
        _zf_restore_engine || die "не удалось установить новые бинарники, откат также завершился ошибкой"
        die "не удалось установить новые бинарники; старые бинарники и сервис восстановлены"
    fi

    printf '  проверяю новый nfqws...\n'
    if ! "$ZF_NFQWS" --version >/dev/null 2>&1; then
        printf '  новый nfqws не запускается — откат к старым бинарникам\n'
        _zf_restore_engine || die "новый nfqws не запускается, откат также завершился ошибкой"
        die "новый nfqws не запускается; старые бинарники и состояние сервиса восстановлены"
    fi
    if (( service_was_active )); then
        printf '  запускаю сервис...\n'
        if ! systemctl start "$ZF_SERVICE" 2>/dev/null; then
            printf '  сервис не поднялся — откат к старым бинарникам\n'
            _zf_restore_engine || die "сервис не поднялся с новым nfqws, откат также завершился ошибкой"
            die "сервис не поднялся с новым nfqws; старые бинарники и сервис восстановлены"
        fi
    fi
    trap - INT TERM HUP

    _zf_invalidate_update_caches
    printf '\nzapret обновлён: %s -> %s\n' "$old_ver" "$(_zf_nfqws_version)"
}

# --- Firewall ownership and uninstall -----------------------------------------
_zf_firewall_owner_file() { printf '%s/.zapret-sonar-firewall\n' "$ZF_ZAPRET_BASE"; }

_zf_record_firewall_ownership() {
    local fwtype qnum table owner tmp
    fwtype=$(_zf_config_literal_or_default FWTYPE "") || return 1
    qnum=$(_zf_config_literal_or_default QNUM 200) || return 1
    table=$(_zf_config_literal_or_default ZAPRET_NFT_TABLE zapret) || return 1
    [[ "$fwtype" == nftables || "$fwtype" == iptables ]] || return 1
    [[ "$qnum" =~ ^[0-9]+$ && qnum -le 65535 ]] || return 1
    [[ "$table" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    owner=$(_zf_firewall_owner_file)
    tmp=$(mktemp "$ZF_ZAPRET_BASE/.firewall-owner.XXXXXX") || return 1
    printf 'FWTYPE=%s\nQNUM=%s\nTABLE=%s\n' "$fwtype" "$qnum" "$table" > "$tmp" \
        && chmod 600 "$tmp" && chown root:root "$tmp" && mv -f "$tmp" "$owner" \
        || { rm -f "$tmp"; return 1; }
}

_zf_firewall_ownership_matches() {
    local owner fwtype qnum table expected
    owner=$(_zf_firewall_owner_file)
    [[ -f "$owner" && ! -L "$owner" && "$(stat -c %u "$owner" 2>/dev/null)" == 0 ]] || return 1
    fwtype=$(_zf_config_literal_or_default FWTYPE "") || return 1
    qnum=$(_zf_config_literal_or_default QNUM 200) || return 1
    table=$(_zf_config_literal_or_default ZAPRET_NFT_TABLE zapret) || return 1
    expected=$(printf 'FWTYPE=%s\nQNUM=%s\nTABLE=%s' "$fwtype" "$qnum" "$table")
    [[ "$(<"$owner")" == "$expected" ]]
}

_zf_nft_table_is_owned() {
    local table="$1" rules kind name qnum expected post_tcp post_udp pre_tcp pre_udp
    qnum=$(_zf_config_literal_or_default QNUM 200) || return 1
    [[ "$qnum" =~ ^[0-9]+$ && qnum -le 65535 ]] || return 1
    rules=$(nft list table inet "$table" 2>/dev/null) || return 1
    grep -Fq "table inet $table {" <<< "$rules" || return 1
    grep -Eq '^[[:space:]]*set zapret \{' <<< "$rules" || return 1
    grep -Eq '^[[:space:]]*set nozapret \{' <<< "$rules" || return 1
    grep -Eq '^[[:space:]]*chain postnat \{' <<< "$rules" || return 1
    grep -Eq '^[[:space:]]*chain prenat \{' <<< "$rules" || return 1
    grep -Eq '^[[:space:]]*chain predefrag_nfqws \{' <<< "$rules" || return 1
    expected='queue([^[:digit:]]|[[:space:]])*to[[:space:]]+'"$qnum"'([^[:digit:]]|$)'
    post_tcp=$(awk '/^[[:space:]]*chain postnat \{/ { in_chain=1; next }
                    /^[[:space:]]*chain / { in_chain=0 }
                    in_chain && /^[[:space:]]*tcp / { print }' <<< "$rules" | grep -Ec "$expected" || true)
    post_udp=$(awk '/^[[:space:]]*chain postnat \{/ { in_chain=1; next }
                    /^[[:space:]]*chain / { in_chain=0 }
                    in_chain && /^[[:space:]]*udp / { print }' <<< "$rules" | grep -Ec "$expected" || true)
    pre_tcp=$(awk '/^[[:space:]]*chain prenat \{/ { in_chain=1; next }
                   /^[[:space:]]*chain / { in_chain=0 }
                   in_chain && /^[[:space:]]*tcp / { print }' <<< "$rules" | grep -Ec "$expected" || true)
    pre_udp=$(awk '/^[[:space:]]*chain prenat \{/ { in_chain=1; next }
                   /^[[:space:]]*chain / { in_chain=0 }
                   in_chain && /^[[:space:]]*udp / { print }' <<< "$rules" | grep -Ec "$expected" || true)
    (( post_tcp == 1 && post_udp == 1 && pre_tcp == 1 && pre_udp == 1 )) || return 1
    while read -r kind name; do
        case "$kind:$name" in
            set:zapret|set:zapret6|set:ipban|set:ipban6|set:nozapret|set:nozapret6|\
            set:lanif|set:wanif|set:wanif6|map:link_local|flowtable:ft|\
            chain:dnat_output|chain:dnat_pre|chain:forward|chain:input|\
            chain:flow_offload|chain:localnet_protect|chain:postrouting|\
            chain:postrouting_hook|chain:postnat|chain:postnat_hook|\
            chain:prerouting|chain:prenat|chain:predefrag|chain:predefrag_nfqws) ;;
            *) return 1 ;;
        esac
    done < <(awk '$1 ~ /^(set|map|flowtable|chain)$/ { print $1, $2 }' <<< "$rules")
}

_zf_iptables_state_is_owned() {
    local qnum rules expected post_tcp post_udp input_tcp input_udp forward_tcp forward_udp
    qnum=$(_zf_config_literal_or_default QNUM 200) || return 1
    [[ "$qnum" =~ ^[0-9]+$ && qnum -le 65535 ]] || return 1
    rules=$(iptables-save -t mangle 2>/dev/null) || return 1
    expected='-j[[:space:]]+NFQUEUE[[:space:]]+--queue-num[[:space:]]+'"$qnum"'([^[:digit:]]|$)'
    post_tcp=$(grep -Ec "^-A POSTROUTING -p tcp .*${expected}" <<< "$rules" || true)
    post_udp=$(grep -Ec "^-A POSTROUTING -p udp .*${expected}" <<< "$rules" || true)
    input_tcp=$(grep -Ec "^-A INPUT -p tcp .*${expected}" <<< "$rules" || true)
    input_udp=$(grep -Ec "^-A INPUT -p udp .*${expected}" <<< "$rules" || true)
    forward_tcp=$(grep -Ec "^-A FORWARD -p tcp .*${expected}" <<< "$rules" || true)
    forward_udp=$(grep -Ec "^-A FORWARD -p udp .*${expected}" <<< "$rules" || true)
    (( post_tcp == 1 && post_udp == 1 && input_tcp == 1 && input_udp == 1 \
        && forward_tcp == 1 && forward_udp == 1 ))
}

_zf_cleanup_firewall_state() {
    local nft_table_owned="${1:-0}" iptables_state_owned="${2:-0}" fwtype qnum table
    fwtype=$(_zf_config_literal_or_default FWTYPE "") || return 1
    case "$fwtype" in
        nftables)
            command -v nft >/dev/null 2>&1 || return 1
            table=$(_zf_config_literal_or_default ZAPRET_NFT_TABLE zapret) || return 1
            [[ "$table" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
            local tables
            tables=$(nft list tables 2>/dev/null) || return 1
            if grep -Fxq "table inet $table" <<< "$tables"; then
                (( nft_table_owned )) || return 1
                nft delete table inet "$table" 2>/dev/null || return 1
                printf '  очищена таблица nftables inet %s\n' "$table"
            fi
            return 0
            ;;
        iptables) ;;
        *) return 1 ;;
    esac

    command -v iptables-save >/dev/null 2>&1 || return 1
    command -v ip6tables-save >/dev/null 2>&1 || return 1
    local rules
    qnum=$(_zf_config_literal_or_default QNUM 200) || return 1
    [[ "$qnum" =~ ^[0-9]+$ && qnum -le 65535 ]] || return 1
    rules=$(iptables-save 2>/dev/null) || return 1
    ! grep -Eq -- "-j NFQUEUE .*--queue-num ${qnum}([^[:digit:]]|$)" <<< "$rules" || return 1
    ! grep -Eq -- '(^|[[:space:]])(input_rule_zapret|--match-set[[:space:]]+(zapret|ipban|nozapret))([[:space:]]|$)' <<< "$rules" || return 1
    rules=$(ip6tables-save 2>/dev/null) || return 1
    ! grep -Eq -- "-j NFQUEUE .*--queue-num ${qnum}([^[:digit:]]|$)" <<< "$rules" || return 1
    ! grep -Eq -- '(^|[[:space:]])(--match-set[[:space:]]+(zapret6|ipban6|nozapret6))([[:space:]]|$)' <<< "$rules" || return 1

    (( iptables_state_owned )) || return 0
    command -v ipset >/dev/null 2>&1 || return 1
    local name removed=0
    for name in zapret zapret6 ipban ipban6 nozapret nozapret6; do
        if ipset list "$name" >/dev/null 2>&1; then
            ipset destroy "$name" 2>/dev/null || return 1
            removed=$((removed + 1))
        fi
    done
    (( removed == 0 )) || printf '  удалено ipset-наборов: %d\n' "$removed"
}

_zf_installed_nfqws_running() {
    local proc exe
    for proc in /proc/[0-9]*; do
        exe=$(readlink "$proc/exe" 2>/dev/null || true)
        [[ "$exe" == "$ZF_NFQWS" || "$exe" == "$ZF_NFQWS (deleted)" ]] && return 0
    done
    return 1
}

_zf_unit_is_owned() {
    local unit="$1"
    [[ -f "$unit" && ! -L "$unit" ]] || return 1
    grep -Fxq "ExecStart=$ZF_ZAPRET_BASE/init.d/sysv/zapret start" "$unit" 2>/dev/null \
        && grep -Fxq "ExecStop=$ZF_ZAPRET_BASE/init.d/sysv/zapret stop" "$unit" 2>/dev/null
}

_zf_service_fragment_path() {
    systemctl show "$ZF_SERVICE" -p LoadState -p FragmentPath -p DropInPaths \
        -p ExecStart -p ExecStop 2>/dev/null
}

_zf_uninstall_restore_service_state() {
    local was_active="$1" was_enabled="$2" restore_ok=1
    if (( was_enabled )); then
        systemctl enable "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
    fi
    if (( was_active )); then
        systemctl start "$ZF_SERVICE" >/dev/null 2>&1 || restore_ok=0
    fi
    (( restore_ok ))
}

cmd_uninstall() {
    [[ $EUID -eq 0 ]] || die "uninstall требует root (sudo $0 uninstall)"
    _zf_lock

    printf 'Удаление zapret-sonar...\n\n'
    printf 'Будет удалено:\n'
    printf '  • сервис %s (остановка + disable)\n' "$ZF_SERVICE"
    printf '  • systemd-юнит /etc/systemd/system/%s.service\n' "$ZF_SERVICE"
    printf '  • firewall state из текущего управляемого конфига\n'
    printf '  • симлинки %s/{zapret-sonar,sonar,zapret-sonar-tui,sonar-tui}\n' "$ZF_BIN_DEST"
    printf '  • рабочая директория %s (включая config.orig и *-user.txt)\n' "$ZF_ZAPRET_BASE"
    printf '\n'

    local confirm
    printf 'Подтвердите [y/N] '; read -r confirm
    [[ "$confirm" =~ ^[yYдД]$ ]] || { printf 'отменено\n'; return 0; }
    printf '\n'

    local unit="/etc/systemd/system/$ZF_SERVICE.service" fragment was_active=0 was_enabled=0
    local enabled_state
    local systemd_show load_state dropins exec_start exec_stop
    local nft_table_owned=0 iptables_state_owned=0 fwtype ownership_matches=0
    case "$ZF_ZAPRET_BASE" in
        ''|/) die "отказываюсь удалять корень или пустой путь: [$ZF_ZAPRET_BASE]" ;;
    esac
    [[ -f "$ZF_ZAPRET_BASE/nfq/nfqws" ]] || die "в $ZF_ZAPRET_BASE нет nfqws — это не наш каталог"
    if [[ -e "$unit" || -L "$unit" ]]; then
        _zf_unit_is_owned "$unit" || die "юнит $unit принадлежит другому проекту"
    fi
    local vendor_unit
    for vendor_unit in "/run/systemd/system/$ZF_SERVICE.service" "/usr/lib/systemd/system/$ZF_SERVICE.service" "/lib/systemd/system/$ZF_SERVICE.service"; do
        [[ ! -e "$vendor_unit" && ! -L "$vendor_unit" ]] \
            || die "обнаружен одноимённый сторонний systemd unit: $vendor_unit"
    done
    systemd_show=$(_zf_service_fragment_path) \
        || die "не удалось получить effective systemd unit $ZF_SERVICE"
    load_state=$(sed -n 's/^LoadState=//p' <<< "$systemd_show")
    fragment=$(sed -n 's/^FragmentPath=//p' <<< "$systemd_show")
    dropins=$(sed -n 's/^DropInPaths=//p' <<< "$systemd_show")
    exec_start=$(sed -n 's/^ExecStart=//p' <<< "$systemd_show")
    exec_stop=$(sed -n 's/^ExecStop=//p' <<< "$systemd_show")
    if [[ "$load_state" != not-found && "$fragment" != "$unit" ]]; then
        die "сервис $ZF_SERVICE загружен из чужого юнита: $fragment"
    fi
    if [[ "$load_state" != not-found ]]; then
        [[ -z "$dropins" || "$dropins" == /usr/lib/systemd/system/service.d/10-timeout-abort.conf ]] \
            || die "у сервиса $ZF_SERVICE есть неожиданный systemd drop-in"
        [[ "$(grep -c '^ExecStart=' <<< "$systemd_show")" == 1 && \
           "$(grep -c '^ExecStop=' <<< "$systemd_show")" == 1 ]] \
            || die "у сервиса $ZF_SERVICE несколько команд запуска/остановки"
        [[ "$exec_start" == *"$ZF_ZAPRET_BASE/init.d/sysv/zapret start"* ]] \
            || die "ExecStart сервиса $ZF_SERVICE принадлежит другому проекту"
        [[ "$exec_stop" == *"$ZF_ZAPRET_BASE/init.d/sysv/zapret stop"* ]] \
            || die "ExecStop сервиса $ZF_SERVICE принадлежит другому проекту"
    fi
    [[ "$(systemctl is-active "$ZF_SERVICE" 2>/dev/null || true)" == active ]] && was_active=1
    enabled_state=$(systemctl is-enabled "$ZF_SERVICE" 2>/dev/null || true)
    [[ "$enabled_state" == enabled || "$enabled_state" == enabled-runtime ]] && was_enabled=1
    _zf_firewall_ownership_matches && ownership_matches=1
    fwtype=$(_zf_config_literal_or_default FWTYPE "") || die "не удалось определить firewall backend"
    if [[ "$fwtype" == nftables ]]; then
        local table tables
        table=$(_zf_config_literal_or_default ZAPRET_NFT_TABLE zapret) \
            || die "не удалось определить nftables table"
        [[ "$table" =~ ^[A-Za-z0-9_.-]+$ ]] || die "некорректное имя nftables table: $table"
        tables=$(nft list tables 2>/dev/null) || die "не удалось прочитать nftables tables"
        if grep -Fxq "table inet $table" <<< "$tables"; then
            (( ownership_matches )) || die "нет ownership marker для nftables table inet $table"
            _zf_nft_table_is_owned "$table" || die "nftables table inet $table не распознана как управляемая"
            nft_table_owned=1
        fi
    elif [[ "$fwtype" == iptables ]] && (( was_active )); then
        _zf_iptables_state_is_owned || die "активный iptables state не распознан как управляемый"
        iptables_state_owned=1
    elif [[ "$fwtype" == iptables ]]; then
        (( ownership_matches )) && iptables_state_owned=1
    fi

    # 1. Остановить и отключить сервис. Stop нужен и для failed/inactive unit:
    # он очищает cgroup и не даёт удалить бинарник под живым процессом.
    if [[ -f "$unit" ]]; then
        systemctl stop "$ZF_SERVICE" || die "не удалось остановить сервис $ZF_SERVICE"
        printf '  сервис остановлен\n'
    fi
    if _zf_installed_nfqws_running; then
        _zf_uninstall_restore_service_state "$was_active" "$was_enabled" \
            || die "после остановки остался nfqws, исходное состояние сервиса восстановить не удалось"
        die "после остановки сервиса остался процесс nfqws, исходное состояние сервиса восстановлено"
    fi
    if [[ -f "$unit" && "$was_enabled" == 1 ]]; then
        if ! systemctl disable "$ZF_SERVICE" 2>/dev/null; then
            _zf_uninstall_restore_service_state "$was_active" "$was_enabled" \
                || die "не удалось отключить автозапуск, исходное состояние сервиса восстановить не удалось"
            die "не удалось отключить автозапуск, исходное состояние сервиса восстановлено"
        fi
        printf '  автозапуск отключён\n'
    fi

    # 2. Очистить оставшееся состояние firewall, пока init scripts доступны
    if ! _zf_cleanup_firewall_state "$nft_table_owned" "$iptables_state_owned"; then
        _zf_uninstall_restore_service_state "$was_active" "$was_enabled" \
            || die "firewall state не очищен, исходное состояние сервиса восстановить не удалось"
        die "firewall state не очищен, исходное состояние сервиса восстановлено"
    fi

    # 3. Удалить systemd-юнит (только если он наш)
    if [[ -f "$unit" ]]; then
        rm -f "$unit" || die "не удалось удалить юнит $unit"
        systemctl daemon-reload || die "не удалось обновить конфигурацию systemd"
        printf '  удалён юнит %s\n' "$unit"
    fi

    # 4. Удалить только симлинки этой установки
    local removed
    removed=$(_zf_remove_command_links) || die "не удалось удалить командные симлинки"
    printf '  удалено симлинков: %d\n' "$removed"

    # 5. Восстановить config.orig если есть
    if [[ -f "$ZF_ZAPRET_BASE/config.orig" ]]; then
        cp -a "$ZF_ZAPRET_BASE/config.orig" "$ZF_ZAPRET_BASE/config" \
            || die "не удалось восстановить config.orig"
        printf '  config.orig восстановлен как config\n'
    fi

    # 6. Удалить рабочую директорию. Все guards проверены до первой мутации.
    rm -rf "$ZF_ZAPRET_BASE" || die "не удалось удалить $ZF_ZAPRET_BASE"
    [[ ! -e "$ZF_ZAPRET_BASE" && ! -L "$ZF_ZAPRET_BASE" ]] \
        || die "рабочая директория сохранилась после удаления: $ZF_ZAPRET_BASE"
    printf '  удалена директория %s\n' "$ZF_ZAPRET_BASE"
    printf '\nzapret-sonar полностью удалён.\n'
}

_zf_remove_command_links() {
    local link expected name removed=0
    for name in zapret-sonar sonar; do
        link="$ZF_BIN_DEST/$name"
        expected="$ZF_ZAPRET_BASE/zapret-sonar/zapret-sonar"
        if [[ -L "$link" && "$(readlink -f "$link")" == "$expected" ]]; then
            rm -f "$link" || return 1
            removed=$((removed + 1))
        fi
    done
    for name in zapret-sonar-tui sonar-tui; do
        link="$ZF_BIN_DEST/$name"
        expected="$ZF_ZAPRET_BASE/zapret-sonar/zapret-sonar-tui"
        if [[ -L "$link" && "$(readlink -f "$link")" == "$expected" ]]; then
            rm -f "$link" || return 1
            removed=$((removed + 1))
        fi
    done
    printf '%d\n' "$removed"
}

cmd_service() {
    local action="$1"
    if ! need_root; then
        _zf_sudo_self _service "$action"
        return $?
    fi
    _zf_lock
    systemctl "$action" "$ZF_SERVICE"
}

cmd_log() {
    case "${1:-}" in
        -f|--follow) journalctl -u "$ZF_SERVICE" -f ;;
        "")          journalctl -u "$ZF_SERVICE" --no-pager -n 50 ;;
        *)           journalctl -u "$ZF_SERVICE" --no-pager --since "$1" ;;
    esac
}

cmd_help() {
    local topic="${1:-}" 
    case "$topic" in
        list)      printf 'Список стратегий Flowseal (* — применённая).\n' ;;
        use)       printf 'Применить стратегию. Можно частью имени: sonar use alt12\n' ;;
        status)    printf 'Состояние сервиса, стратегии, версии zapret/Flowseal, окружение.\n' ;;
        check)     printf 'Проверить HTTP, контент, скорость и HTTP/3/QUIC. Не проверяет Discord Voice/UDP.\n  --json — совместимый агрегированный JSON v1\n  --json-v2 — категории и результаты отдельных проверок\n' ;;
        validate)  printf 'Проверить все установленные стратегии без изменения конфига или сервиса.\n  --json — машинно-читаемый результат\n' ;;
        export-diagnostic) printf 'Сформировать безопасный JSON для отчёта об ошибке.\n  --output <файл> — записать атомарно с правами 0600\n' ;;
        snapshots) printf 'Показать доступные snapshots Flowseal.\n  --json — машинно-читаемый результат\n' ;;
        rollback)  printf 'Переключить Flowseal на предыдущий или указанный snapshot.\n' ;;
        self-update) printf 'Обновить сам zapret-sonar из проверенного release asset.\n  --force — переустановить ту же версию\n  --version <версия> — установить конкретную версию\n' ;;
        try)       printf 'Перебрать все стратегии, показать рабочие.\n  --keep — оставить первую заработавшую\n' ;;
        baseline)  printf 'Что заблокировано БЕЗ обхода (сервис останавливается на время замера).\n' ;;
        update)    printf 'Обновить стратегии, списки и .bin из GitHub Flowseal.\n  --force — обновить даже если версия та же\n' ;;
        upgrade)   printf 'Обновить движок zapret (nfqws, ip2net, mdig) с sha256.\n  --force — обновить даже если версия та же\n' ;;
        uninstall) printf 'Полностью удалить zapret-sonar (сервис, юнит, файлы, симлинки).\n' ;;
        gamefilter) printf 'Обход для игр (порты >1023).\n  Режимы: off|tcp|udp|both\n' ;;
        ipset)     printf 'Фильтр по IP из ipset-all.txt.\n  Режимы: none|any|loaded\n  any ломает доступ к обычным сайтам\n' ;;
        site)      printf 'Управление списком list-general-user.txt.\n  site <домен> — добавить\n  site --list — показать\n  site --remove <домен> — удалить\n  Поддомены учитываются автоматически.\n' ;;
        start|stop|restart|enable|disable) printf 'Управление сервисом zapret.\n  enable/disable — автозапуск.\n' ;;
        log)       printf 'Логи сервиса (journalctl).\n  log — последние 50 строк\n  log -f — следить в реальном времени\n  log "1 hour ago" — за период\n' ;;
        doctor)    printf 'Сводная диагностика сервиса, конфига, nfqws и стратегии. sudo дополнительно проверяет firewall interception.\n' ;;
        *)         usage ;;
    esac
}

usage() {
    cat <<'EOF'
zapret-sonar — стратегии Flowseal поверх zapret v1

  list                  список стратегий (* — применённая)
  use <стратегия>       применить (можно частью имени: use alt12)
  status                состояние сервиса, стратегии, версии, окружения
  check [--json|--json-v2] доступность заданных HTTP/CDN-целей
  validate [--json]     проверить все стратегии без применения
  export-diagnostic     безопасный JSON для отчёта об ошибке
  snapshots [--json]    доступные snapshots Flowseal
  rollback [snapshot]   переключить Flowseal на предыдущий snapshot
  try [--keep]          перебрать все стратегии, показать рабочие
                         (--keep — оставить первую заработавшую)
  baseline              что заблокировано БЕЗ обхода (сервис временно выключается)
  update [--force]      обновить стратегии, списки и .bin из GitHub Flowseal
  upgrade [--force]     обновить движок zapret (nfqws, ip2net, mdig)
  self-update           обновить сам zapret-sonar
  uninstall             полностью удалить zapret-sonar (сервис, файлы, юнит)
  gamefilter [режим]    off|tcp|udp|both — обход для игр (порты >1023)
  ipset [режим]         none|any|loaded — фильтр по IP из ipset-all.txt
  site <домен>          добавить домен в list-general-user.txt
  site --list           показать список доменов
  site --remove <домен> удалить домен из списка
  start|stop|restart    управление сервисом
  enable|disable        автозапуск сервиса
  log [-f] [период]     логи сервиса (journalctl)
  doctor                сводная диагностика установки и активной стратегии

  --debug               подробный вывод (трейс, verbose curl)
  --version|-v          версия

Стратегии подбираются перебором: рабочая зависит от провайдера.
EOF
}

if [[ "${ZF_LIBRARY_MODE:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

# --debug: убираем из аргументов, включаем трейс
ZF_DEBUG=0
_zf_debug_args=()
for _zf_a in "$@"; do
    case "$_zf_a" in
        --debug) ZF_DEBUG=1 ;;
        *)       _zf_debug_args+=("$_zf_a") ;;
    esac
done
set -- "${_zf_debug_args[@]}"
unset _zf_a _zf_debug_args
(( ZF_DEBUG )) && set -x
ZF_CMD="${1:-}"

# --help для подкоманд: sonar try --help → справка по try
if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
    case "$1" in
        list|use|status|check|validate|export-diagnostic|snapshots|rollback|try|baseline|update|upgrade|self-update|uninstall|gamefilter|ipset|site|start|stop|restart|log|doctor)
            cmd_help "$1"; exit 0 ;;
    esac
fi

case "${1:-}" in
    list)       shift; cmd_list "$@" ;;
    use)        shift; cmd_use "$@" ;;
    status)     shift; cmd_status "$@" ;;
    check)      shift; cmd_check "$@" ;;
    validate)   shift; cmd_validate "$@" ;;
    export-diagnostic) shift; cmd_export_diagnostic "$@" ;;
    snapshots)  shift; cmd_snapshots "$@" ;;
    rollback)   shift; cmd_rollback "$@" ;;
    try)        shift; cmd_try "$@" ;;
    baseline)   shift; cmd_baseline "$@" ;;
    update)     shift; cmd_update "$@" ;;
    upgrade)    shift; cmd_upgrade "$@" ;;
    self-update) shift; cmd_self_update "$@" ;;
    uninstall)  shift; cmd_uninstall "$@" ;;
    gamefilter) shift; cmd_gamefilter "$@" ;;
    ipset)      shift; cmd_ipset "$@" ;;
    site)       shift; cmd_site "$@" ;;
    start|stop|restart|enable|disable) cmd_service "$1" ;;
    log)        shift; cmd_log "$@" ;;
    doctor)     shift; cmd_doctor "$@" ;;
    help)       shift; cmd_help "$@" ;;
    _apply)     shift; cmd_apply "$@" ;;
    _render)    shift; cmd_render "$@" ;;
    _update)    shift; cmd_update "$@" ;;
    _upgrade)   shift; cmd_do_upgrade "$@" ;;
    _self_update) shift; cmd_self_update "$@" ;;
    _rollback)  shift; cmd_rollback "$@" ;;
    _ipset_set) shift; cmd_ipset_set "$@" ;;
    _site_add)  shift; cmd_site_mutate add "$@" ;;
    _site_remove) shift; cmd_site_mutate remove "$@" ;;
    _service)   shift; cmd_service "$@" ;;
    _baseline)  shift; cmd_baseline "$@" ;;
    _state)     shift; cmd_state "$@" ;;
    _describe)  shift; cmd_describe "$@" ;;
    _list)      shift; zf_list_strategies ;;
    _snapshot_ids) cmd_snapshot_ids ;;
    _update_status) _zf_update_status ;;
    _update_status_wait) _zf_update_status_wait ;;
    _update_check_worker) _zf_do_update_check ;;
    ''|-h|--help) usage ;;
    -v|--version) printf 'zapret-sonar %s\n' "$ZF_VERSION" ;;
    *) die "неизвестная команда: $1 (--help)" ;;
esac
_zf_command_rc=$?

# Уведомление об обновлениях — только в интерактивном терминале
if [[ -t 1 && "${ZF_DEBUG:-0}" == "0" && "${ZF_MACHINE_OUTPUT:-0}" == "0" ]]; then
    case "$ZF_CMD" in
        _*|-v|--version|''|-h|--help) ;;
        *) _zf_update_notify 2>/dev/null ;;
    esac
fi
exit "$_zf_command_rc"
